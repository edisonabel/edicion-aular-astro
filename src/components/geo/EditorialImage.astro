---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { IMAGENES, type ImagenId } from '../../data/ia/imagenes';
interface Props { imagen: ImagenId; panoramica?: boolean; prioritaria?: boolean }
const { imagen, panoramica = false, prioritaria = false } = Astro.props;
const asset = IMAGENES[imagen];
const disponible = existsSync(resolve('public/img/ia', asset.archivo));
---
<figure class:list={['geo-editorial-image', { 'is-wide': panoramica }]} data-image-slot={imagen}>
  {disponible ? (
    <img src={`/img/ia/${asset.archivo}`} alt={asset.alt} width={panoramica ? 1920 : 1200} height={panoramica ? 960 : 1200} loading={prioritaria ? 'eager' : 'lazy'} fetchpriority={prioritaria ? 'high' : 'auto'} decoding="async" />
  ) : (
    <div class="geo-editorial-card bringer-block">
      <span class="bringer-label">Edición Aular · IA aplicada</span>
      <div class="geo-editorial-motif" aria-hidden="true"><span></span><span></span><span></span></div>
      <div><p class="geo-editorial-title">{asset.titulo}</p><p>{asset.detalle}</p></div>
    </div>
  )}
</figure>
