---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/geo/JsonLd.astro';
import Breadcrumbs from '../../components/geo/Breadcrumbs.astro';
import FaqList from '../../components/geo/FaqList.astro';
import Normativa from '../../components/geo/Normativa.astro';
import Cta from '../../components/geo/Cta.astro';
import { SOLUCIONES } from '../../data/ia/soluciones';
import { ZONAS } from '../../data/ia/zonas';
import { SECTORES } from '../../data/ia/sectores';
import { NEGOCIO, ESTADISTICAS } from '../../data/ia/negocio';
import { breadcrumbs, localBusiness, faqPage, webPage } from '../../lib/schema';

const pageTitle = "Soluciones con Inteligencia Artificial en Medellín | Edición Aular";
const pageDesc = "Implementación de soluciones prácticas de IA para empresas: agentes de WhatsApp 24/7, automatización de procesos, diseño web y posicionamiento en Google y ChatGPT.";
const pageUrl = "/soluciones-ia";

const faqsHub = [
  {
    q: "¿Por qué contratar una solución de IA en lugar de usar herramientas gratuitas?",
    a: "Las herramientas como ChatGPT, Make o bots genéricos están democratizadas y al alcance de todos. La dificultad no está en acceder al software, sino en diseñar la solución para el problema específico de tu empresa: entrenar la IA con tus datos, conectarla a tu CRM o WhatsApp oficial, cumplir la Ley 1581 de protección de datos y medir el retorno."
  },
  {
    q: "¿Qué tipo de soluciones de IA tienen mayor retorno de inversión (ROI) para una pyme?",
    a: "En Colombia, los agentes de WhatsApp para atención y agendamiento 24/7 y la automatización de procesos repetitivos (registro de prospectos, cotizaciones y recordatorios) son los que entregan resultados más rápidos al evitar la pérdida de clientes y liberar horas de nómina."
  },
  {
    q: "¿En qué zonas de Medellín y el Valle de Aburrá prestan servicio presencial?",
    a: "Atendemos presencialmente en El Poblado, Laureles, Calasanz, El Tesoro, Centro de Medellín, Belén, Envigado, Itagüí, Sabaneta y Bello. También realizamos diagnósticos e implementaciones remotas para todo el país."
  }
];

const schemaData = [
  webPage({ name: pageTitle, description: pageDesc, path: pageUrl }),
  localBusiness(),
  breadcrumbs([
    { name: "Inicio", href: "/" },
    { name: "Soluciones con IA", href: pageUrl }
  ]),
  faqPage(faqsHub)
];
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <JsonLd slot="head" data={schemaData} />

  <div class="stg-container">
    <Breadcrumbs items={[
      { name: "Inicio", href: "/" },
      { name: "Soluciones con IA" }
    ]} />

    <!-- Section: Page Title (Bringer services.html Style) -->
    <section class="backlight-bottom">
      <div class="stg-row">
        <div class="stg-col-8 stg-offset-2 align-center stg-tp-col-10 stg-tp-offset-1">
          <h1 class="bringer-page-title" data-appear="fade-up" data-unload="fade-up">
            Soluciones con Inteligencia Artificial<span class="bringer-accent">.</span>
          </h1>
          <p class="bringer-large-text" data-split-appear="fade-up" data-delay="100" data-split-unload="fade-up">
            Las herramientas existen y están democratizadas; en Edición Aular diseñamos la solución al problema real de tu empresa.
          </p>
        </div>
      </div>
    </section>

    <!-- Section: Intro con Parallax Media (Bringer services.html Style) -->
    <section>
      <div class="bringer-parallax-media stg-bottom-gap-l" data-appear="fade-up" data-unload="fade-up">
        <img class="bringer-lazy" src="/img/null.png" data-src="/img/inner-pages/services.jpg" alt="Soluciones con Inteligencia Artificial" width="1920" height="960">
      </div>

      <div class="stg-row stg-bottom-gap">
        <div class="stg-col-7" data-unload="fade-left">
          <h2 class="stg-bottom-gap" data-split-appear="fade-up">Tecnología enfocada en resultados comerciales medibles.</h2>
        </div>
        <div class="stg-col-5"></div>
      </div>

      <div class="stg-row stg-tp-column-reverse">
        <div class="stg-col-6 stg-valign-bottom" data-unload="fade-left">
          <div class="align-right">
            <a href={NEGOCIO.agenda} target="_blank" rel="noopener" class="bringer-icon-link" data-appear="fade-right">
              <div class="bringer-icon-link-content">
                <h6>
                  Descubre qué procesos
                  <br>
                  puedes optimizar hoy
                </h6>
                <span class="bringer-label">Agenda un Diagnóstico</span>
              </div>
              <div class="bringer-icon-wrap">
                <i class="bringer-icon bringer-icon-explore"></i>
              </div>
            </a>
          </div>
        </div>

        <div class="stg-col-6 stg-tp-col-9 stg-tp-bottom-gap" data-appear="fade-left" data-unload="fade-right">
          <p class="bringer-large-text">
            {NEGOCIO.propuesta}
          </p>
        </div>
      </div>
    </section>

    <!-- Section: Counters / Estadísticas de Contexto (Bringer Counters Style) -->
    <section class="stg-bottom-gap-l">
      <div class="stg-row stg-valign-bottom">
        <div class="stg-col-4 stg-tp-col-4 stg-m-col-12" data-appear="fade-up" data-delay="100">
          <div class="bringer-counter bringer-small-counter">
            <div class="bringer-counter-number">+90%</div>
            <div class="bringer-counter-label">Uso de WhatsApp en Colombia</div>
            <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Fuente: {ESTADISTICAS.whatsapp.fuente}</p>
          </div>
        </div>

        <div class="stg-col-4 stg-tp-col-4 stg-m-col-12" data-appear="fade-up" data-delay="200">
          <div class="bringer-counter bringer-small-counter">
            <div class="bringer-counter-number">4 de 10</div>
            <div class="bringer-counter-label">Empresas prueban IA en sus flujos</div>
            <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Fuente: {ESTADISTICAS.adopcionIA.fuente}</p>
          </div>
        </div>

        <div class="stg-col-4 stg-tp-col-4 stg-m-col-12" data-appear="fade-up" data-delay="300">
          <div class="bringer-counter bringer-small-counter">
            <div class="bringer-counter-number">62%</div>
            <div class="bringer-counter-label">Iniciativas estancadas en piloto</div>
            <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Fuente: {ESTADISTICAS.pilotos.fuente}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section: Detailed Services List (Bringer services.html Detailed List) -->
    <section class="backlight-top">
      <div class="stg-row bringer-section-title">
        <div class="stg-col-10 stg-offset-1">
          <div class="align-center">
            <h2 data-split-appear="fade-up" data-split-unload="fade-up">Catálogo de soluciones prácticas con Inteligencia Artificial.</h2>
            <p class="bringer-large-text" data-appear="fade-up" data-delay="100">
              Flujos desarrollados a la medida de tu operación comercial y administrativa:
            </p>
          </div>
        </div>
      </div>

      <div class="bringer-detailed-list-wrap" data-appear="fade-up" data-delay="200" data-unload="fade-up">
        <ul class="bringer-detailed-list">
          {SOLUCIONES.map((sol) => (
            <li data-stagger-appear="fade-up" data-stagger-delay="75">
              <div class="bringer-detailed-list-title">
                <h4>{sol.nombre}<span class="bringer-accent">.</span></h4>
              </div>
              <div class="bringer-detailed-list-description">
                <p>{sol.respuesta}</p>
              </div>
              <div class="bringer-detailed-list-button">
                <span class="bringer-icon bringer-icon-explore"></span>
              </div>
              <a href={`/soluciones-ia/${sol.slug}`}></a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Section: Sectores Especializados (Bringer 3-cols square grid) -->
    <section>
      <div class="align-center stg-bottom-gap-l">
        <h2 data-split-appear="fade-up">Sectores comerciales prioritarios</h2>
        <p class="bringer-large-text" data-appear="fade-up" data-delay="100">
          Adaptadas a las objeciones, canales y normativas de cada industria:
        </p>
      </div>

      <div class="bringer-grid-3cols bringer-tp-grid-2cols bringer-tp-stretch-last-item" data-stagger-appear="fade-up">
        {SECTORES.map((sec) => (
          <div class="bringer-block stg-aspect-square stg-vertical-space-between">
            <div>
              <span class="bringer-label">Sector</span>
              <h4 class="stg-top-gap-s">{sec.nombre}<span class="bringer-accent">.</span></h4>
              <p style="font-size: 0.95rem; color: #cbd5e1; margin-top: 0.5rem;">{sec.respuesta}</p>
            </div>
            <a href={`/sectores/${sec.slug}`} class="bringer-arrow-link stg-top-gap-s">
              Ver soluciones del sector
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Section: Zonas de Medellín (Bringer Grid) -->
    <section>
      <div class="stg-row bringer-section-title">
        <div class="stg-col-8 stg-offset-2 align-center">
          <h2 data-split-appear="fade-up">Cobertura en Medellín y Valle de Aburrá</h2>
          <p class="bringer-large-text" data-appear="fade-up" data-delay="100">
            Atención presencial y virtual en los principales corredores comerciales:
          </p>
        </div>
      </div>

      <div class="bringer-grid-3cols stg-top-gap-s" data-stagger-appear="fade-up">
        {ZONAS.map((z) => (
          <div class="bringer-block" style="padding: 1.5rem;">
            <span class="bringer-label">{z.tipo.toUpperCase()} · {z.municipio}</span>
            <h4 class="stg-top-gap-s">
              <a href={`/medellin/${z.slug}`} style="color: inherit; text-decoration: none;">
                {z.nombre}
              </a>
            </h4>
            <p style="font-size: 0.9rem; color: #cbd5e1; margin: 0.5rem 0;">{z.intro.substring(0, 110)}...</p>
            <a href={`/medellin/${z.slug}`} class="bringer-arrow-link stg-top-gap-s" style="font-size: 0.9rem;">
              Ver soluciones en {z.nombre}
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Section: Normativa -->
    <Normativa claves={['habeasData', 'ley2300', 'conpesIA']} />

    <!-- Section: FAQs con Acordeón Nativo -->
    <FaqList faqs={faqsHub} titulo="Preguntas frecuentes sobre soluciones con IA" />

    <!-- Section: Bento CTA Oficial Bringer -->
    <Cta 
      titulo="¿Listo para implementar IA en tu empresa?"
      subtitulo="Revisamos los cuellos de botella de tu equipo y diseñamos un flujo de atención o automatización a la medida."
      enlace={NEGOCIO.agenda}
    />
  </div>
</BaseLayout>
