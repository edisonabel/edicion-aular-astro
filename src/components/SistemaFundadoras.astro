---
import { FUNDADORAS, OFERTA } from '../data/ia/sistema-oferta';
import { NEGOCIO } from '../data/ia/negocio';
const grupos = [
  { titulo: 'Lo que recibes', items: FUNDADORAS.recibes },
  { titulo: 'Lo que te pedimos', items: FUNDADORAS.aCambio },
];
---
<section class="sf2" id="clinicas-fundadoras" data-sf2>
  <div class="sf2-panel" data-appear="fade-up">
    <div class="sf2-main">
      <span class="sf2-label">Clínicas fundadoras</span>
      <h2>Buscamos nuestras primeras clínicas.</h2>
      <p>Llevamos años en marca, web, video y pauta, y ahora llevamos ese trabajo a salud y estética. Aún no tenemos casos publicados de este sistema, así que lo abrimos con un grupo pequeño de clínicas para construirlo con ellas.</p>
      <div class="sf2-actions">
        <button type="button" class="sf2-cta" data-sf2-whatsapp data-contact-channel="whatsapp">Postular mi clínica <span aria-hidden="true">↗</span></button>
        <a href={NEGOCIO.agenda} target="_blank" rel="noopener" class="sf2-link">Agendar 15 minutos</a>
      </div>
      <p class="sf2-precio">{OFERTA.precioDesde ? `Precio de fundadora desde ${OFERTA.precioDesde}.` : 'El precio de fundadora se acuerda según el alcance, antes de empezar.'}{OFERTA.cupos ? ` Cupos disponibles: ${OFERTA.cupos}.` : ''}</p>
    </div>
    <div class="sf2-side">
      {grupos.map(grupo => <div class="sf2-group"><h3>{grupo.titulo}</h3><ul>{grupo.items.map(item => <li>{item}</li>)}</ul></div>)}
    </div>
  </div>
  <div class="sf2-mes">
    <div><span class="bringer-label" data-appear="fade-up">Tu primer mes</span><h3 data-appear="fade-up">Lo que buscamos dejar funcionando<span class="bringer-accent">.</span></h3><p>El alcance final depende de tus herramientas y lo definimos antes de empezar.</p></div>
    <ol data-stagger-appear="fade-up" data-stagger-delay="80">{FUNDADORAS.primerMes.map((item, index) => <li><span aria-hidden="true">{index + 1}</span>{item}</li>)}</ol>
  </div>
</section>
<script>
  import { fundadorasWhatsapp } from '../lib/demo-atencion.js';
  // Como en el orientador: el botón no expone la URL con el mensaje a la medición automática de enlaces.
  document.querySelector('[data-sf2-whatsapp]')?.addEventListener('click',()=>{window.location.assign(fundadorasWhatsapp().whatsapp);});
</script>
<style is:global>
  .sf2{padding:clamp(48px,7vw,96px) 0;scroll-margin-top:72px}
  .sf2-panel{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(24px,4vw,56px);padding:clamp(24px,4.5vw,60px);border-radius:var(--bringer-large-br);background:var(--ea-gradiente);color:#fff}
  .sf2-label{display:block;font-size:12px;font-weight:600;letter-spacing:.12em;line-height:1.5;text-transform:uppercase;color:#fff}
  .sf2-main h2{margin:12px 0 16px;font-size:clamp(34px,5vw,64px);font-weight:600;line-height:1.05;letter-spacing:-.045em;color:#fff}.sf2-main>p{margin:0;font-size:clamp(16px,1.5vw,19px);line-height:1.5;color:#fff}
  .sf2-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin:26px 0 14px}.sf2 .sf2-cta{display:inline-flex;align-items:center;gap:10px;min-height:52px;margin:0;padding:12px 22px;border:0;border-radius:6px;background:#07090D;color:#fff;font:inherit;font-size:15px;font-weight:600;line-height:1.3;letter-spacing:0;text-transform:none;cursor:pointer;transition:opacity .15s}.sf2 .sf2-cta:hover{background:#07090D;color:#fff;opacity:.85}.sf2-link{color:#fff;font-size:15px;text-decoration:underline;text-underline-offset:.25em}.sf2-link:hover{color:#fff}
  .sf2 .sf2-precio{font-size:14px}
  .sf2-side{display:flex;flex-direction:column;gap:12px}.sf2-group{padding:clamp(16px,2vw,24px);border-radius:var(--bringer-default-br);background:#F5F7FA;color:#07090D}.sf2-group h3{margin:0 0 10px;font-size:18px;font-weight:600;line-height:1.25;letter-spacing:-.015em;color:#07090D}
  .sf2 .sf2-group ul{margin:0;padding:0;list-style:none}.sf2 .sf2-group li{position:relative;margin:0 0 8px;padding:0 0 0 26px;font-size:15px;line-height:1.35;color:#2A2D35;list-style:none}.sf2 .sf2-group li:last-child{margin-bottom:0}.sf2 .sf2-group li::marker{content:none}.sf2 .sf2-group li::before{content:'✓';position:absolute;top:1px;left:0;display:grid;place-items:center;width:18px;height:18px;border-radius:50%;background:#07090D;color:#fff;font-size:10px;font-weight:600}
  .sf2-mes{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:clamp(24px,5vw,72px);align-items:start;margin-top:clamp(40px,6vw,72px)}.sf2-mes h3{margin:12px 0;font-size:clamp(26px,3.2vw,40px);font-weight:600;line-height:1.12;letter-spacing:-.035em}.sf2-mes>div p{margin:0;font-size:15px;line-height:1.5;color:var(--bringer-s-heading-fade)}
  .sf2 .sf2-mes ol{margin:0;padding:0;list-style:none}.sf2 .sf2-mes li{display:flex;align-items:center;gap:14px;margin:0;padding:clamp(14px,1.8vw,20px) 0;border-top:1px solid var(--bringer-s-border);font-size:clamp(17px,1.7vw,21px);line-height:1.25;color:var(--bringer-s-heading);list-style:none}.sf2 .sf2-mes li::marker{content:none}.sf2 .sf2-mes li>span{display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:10px;background:var(--ea-gradiente);color:#fff;font-size:14px;font-weight:600}
  .sf2 :is(button,a):focus-visible{outline:3px solid currentColor;outline-offset:3px}
  @media(max-width:860px){.sf2-panel,.sf2-mes{grid-template-columns:minmax(0,1fr)}}
</style>
