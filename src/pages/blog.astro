---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import JsonLd from '../components/geo/JsonLd.astro';
import blogData from '../data/blog.json';
import { normalizeSearch } from '../lib/blog';
import { ORG_ID } from '../lib/schema';
const posts = [...blogData].sort((a, b) => b.date.localeCompare(a.date));
const categories = [...new Set(posts.map(p => p.category))];
const featured = posts.filter(p => p.featured).slice(0, 3);
---
<BaseLayout title="Blog de IA, diseño web y marketing | Edición Aular" description="Guías prácticas para decidir qué automatizar, mejorar tu sitio web y organizar el marketing de tu negocio. Explora el blog de Edición Aular.">
  <JsonLd slot="head" data={{ '@context': 'https://schema.org', '@type': 'Blog', name: 'Blog de Edición Aular', url: 'https://edicionaular.com/blog/', publisher: { '@id': ORG_ID }, inLanguage: 'es-CO' }} />
  <div class="stg-container blog-index">
    <section class="blog-intro align-center">
      <p class="blog-eyebrow">Ideas para tomar mejores decisiones</p>
      <h1 class="bringer-page-title">IA, diseño y marketing para tu negocio<span class="bringer-accent">.</span></h1>
      <p class="bringer-large-text">Guías y criterios prácticos para conectar las herramientas con los problemas de tu operación.</p>
      <div class="blog-search"><label for="blogSearch">Buscar en el blog</label><input id="blogSearch" type="search" placeholder="Por ejemplo: asistente, diseño o automatización" aria-controls="blog-posts" /></div>
      <p class="blog-rss"><a href="/rss.xml">Seguir los artículos por RSS</a></p>
    </section>
    {featured.length > 0 && <section id="blog-featured" aria-labelledby="featured-title"><h2 id="featured-title">Para empezar</h2><div class="blog-grid">{featured.map(post => <BlogCard post={post} />)}</div></section>}
    <section aria-labelledby="archive-title">
      <h2 id="archive-title">Explora los artículos</h2>
      <div class="blog-filters" role="group" aria-label="Filtrar por tema">
        <button type="button" data-category="" aria-pressed="true">Todos los temas</button>
        {categories.map(category => <button type="button" data-category={category} aria-pressed="false">{category}</button>)}
      </div>
      <p id="blog-results" role="status" aria-live="polite" aria-atomic="true">{posts.length} artículos disponibles</p>
      <div id="blog-posts" class="blog-grid">{posts.map(post => <div data-blog-post data-category={post.category} data-search={normalizeSearch([post.title, post.excerpt, post.category, ...(post.tags || [])].join(' '))}><BlogCard post={post} /></div>)}</div>
      <p id="blog-empty" hidden>Prueba con otra palabra o selecciona «Todos los temas».</p>
    </section>
    <section class="divider-top"><div class="bringer-block blog-next">
      <div><p class="blog-eyebrow">De la lectura a tu operación</p><h2>¿Qué necesitas resolver?</h2><p>Conoce las soluciones de IA o conversemos sobre el alcance de tu proyecto.</p></div>
      <div class="blog-actions"><a href="/soluciones-ia/" class="bringer-button">Explorar soluciones con IA</a><a href="https://cal.com/edicion-aular-website" class="bringer-arrow-link">Conversar sobre mi proyecto</a></div>
    </div></section>
  </div>
</BaseLayout>
<script>
  import { normalizeSearch } from '../lib/blog';
  const input = document.querySelector<HTMLInputElement>('#blogSearch');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.blog-filters button')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-blog-post]')];
  const results = document.querySelector('#blog-results');
  const featured = document.querySelector<HTMLElement>('#blog-featured');
  const empty = document.querySelector<HTMLElement>('#blog-empty');
  let category = '';
  function filterPosts() {
    const query = normalizeSearch(input?.value.trim() || '');
    let count = 0;
    for (const card of cards) {
      card.hidden = !!((category && card.dataset.category !== category) || !card.dataset.search?.includes(query));
      if (!card.hidden) count++;
    }
    if (results) results.textContent = `${count} ${count === 1 ? 'artículo disponible' : 'artículos disponibles'}${category ? ` en ${category}` : ''}`;
    if (empty) empty.hidden = count !== 0;
    if (featured) featured.hidden = !!(query || category);
  }
  input?.addEventListener('input', filterPosts);
  buttons.forEach(button => button.addEventListener('click', () => {
    category = button.dataset.category || '';
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    filterPosts();
  }));
</script>
<style>
  .blog-index [hidden] { display: none !important; }
  .blog-intro { max-width: 950px; margin: auto; }
  .blog-eyebrow { color: var(--bringer-s-text-accent); font-size: .85rem; font-weight: 600; }
  .blog-search { max-width: 720px; margin: 2rem auto 0; text-align: left; }
  .blog-search label { display: block; color: var(--bringer-s-heading); margin-bottom: .6rem; }
  .blog-search input { width: 100%; background: var(--bringer-s-container-bg); color: var(--bringer-s-heading); border: 1px solid var(--bringer-s-border); border-radius: 12px; padding: 1rem; }
  .blog-search input::placeholder { color: var(--bringer-s-text); opacity: 1; }
  .blog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .blog-filters { display: flex; flex-wrap: wrap; gap: .65rem; margin: 1.5rem 0; }
  .blog-filters button { font: inherit; font-size: .9rem; color: var(--bringer-s-heading); background: var(--bringer-s-container-bg); border: 1px solid var(--bringer-s-border); border-radius: 8px; padding: .6rem .9rem; cursor: pointer; }
  .blog-filters button[aria-pressed="true"] { border-color: var(--bringer-s-text-accent); box-shadow: inset 0 -3px var(--bringer-s-text-accent); }
  .blog-index :is(button,input,a):focus-visible { outline: 3px solid var(--bringer-s-text-accent); outline-offset: 4px; }
  .blog-next { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: center; }
  .blog-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1.2rem; }
  @media(max-width: 1000px) { .blog-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(max-width: 650px) { .blog-grid,.blog-next { grid-template-columns: minmax(0,1fr); } }
</style>
