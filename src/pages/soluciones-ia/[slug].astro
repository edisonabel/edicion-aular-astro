---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedReading from '../../components/blog/RelatedReading.astro';
import { READINGS_BY_SOLUTION } from '../../data/blog-relations';
import Programa from '../../components/geo/Programa.astro';
import JsonLd from '../../components/geo/JsonLd.astro';
import Breadcrumbs from '../../components/geo/Breadcrumbs.astro';
import FaqList from '../../components/geo/FaqList.astro';
import Normativa from '../../components/geo/Normativa.astro';
import Cta from '../../components/geo/Cta.astro';
import DemoAtencion from '../../components/DemoAtencion.astro';
import SolucionHero from '../../components/SolucionHero.astro';
import SolucionLab from '../../components/SolucionLab.astro';
import { SOLUCIONES, type Solucion } from '../../data/ia/soluciones';
import { ZONAS } from '../../data/ia/zonas';
import { SECTORES } from '../../data/ia/sectores';
import { NEGOCIO } from '../../data/ia/negocio';
import { breadcrumbs, faqPage, service, webPage } from '../../lib/schema';

export function getStaticPaths() {
  return SOLUCIONES.map((solucion) => ({
    params: { slug: solucion.slug },
    props: { solucion },
  }));
}

interface Props {
  solucion: Solucion;
}

const { solucion } = Astro.props;
const pageUrl = `/soluciones-ia/${solucion.slug}`;
const esAgente = solucion.slug === 'agentes-ia-whatsapp';

const zonasRelevantes = ZONAS.filter((z) => z.enfoque.includes(solucion.slug)).slice(0, 4);
const sectoresRelevantes = SECTORES.filter((s) => s.usos.some((u) => u.solucion === solucion.slug));

const schemaData = [
  webPage({ name: solucion.title, description: solucion.description, path: pageUrl }),
  service({
    name: solucion.nombre,
    description: solucion.description,
    path: pageUrl,
    serviceType: solucion.keyword,
  }),
  breadcrumbs([
    { name: "Inicio", href: "/" },
    { name: "Soluciones con IA", href: "/soluciones-ia" },
    { name: solucion.nombre, href: pageUrl }
  ]),
  faqPage(solucion.faqs)
];


---

<BaseLayout title={solucion.title} description={solucion.description}>
  <JsonLd slot="head" data={schemaData} />

  <div class="stg-container geo-page">
    <Breadcrumbs items={[
      { name: "Inicio", href: "/" },
      { name: "Soluciones con IA", href: "/soluciones-ia" },
      { name: solucion.nombre }
    ]} />

    <SolucionHero solucion={solucion} destino={esAgente ? '#demo-atencion' : '#laboratorio'} />

    <section class="ss-problema" id="problema-solucion" data-template="propio#problema">
      <span class="bringer-label" data-appear="fade-up">El problema real</span>
      <p class="ss-frase" data-split-appear="fade-up" data-split-by="line">{solucion.problema}</p>
    </section>

    {esAgente ? <DemoAtencion titulo="Pruébalo como lo haría un cliente" /> : <SolucionLab solucion={solucion} />}

    <section class="ss-proceso" id="proceso" data-template="home06.html#steps" data-ss-proceso>
      <div class="ss-head"><span class="bringer-label" data-appear="fade-up">Plazo orientativo: {solucion.tiempo}</span><h2 data-split-appear="fade-up" data-split-by="line">Del diagnóstico a la puesta en marcha<span class="bringer-accent">.</span></h2><p class="bringer-large-text" data-appear="fade-up" data-delay="100">Confirmamos el calendario después de revisar el alcance.</p></div>
      <ol class="ss-steps" aria-label="Etapas del proyecto">
        {solucion.proceso.map((step, index) => <li style={`--i:${index}`}><span class="ss-num" aria-hidden="true">{index + 1}</span><h3>{step.paso}</h3><p>{step.detalle}</p></li>)}
      </ol>
    </section>

    <section class="ss-incluye" id="que-incluye" data-template="service-details.html#offer">
      <div class="ss-head"><span class="bringer-label" data-appear="fade-up">Entregables</span><h2 data-split-appear="fade-up" data-split-by="line">Qué incluye esta solución<span class="bringer-accent">.</span></h2><p class="bringer-large-text" data-appear="fade-up" data-delay="100">Definimos los entregables en la propuesta y dejamos claro qué podrá operar tu equipo.</p></div>
      <ol class="ss-list" data-stagger-appear="fade-up" data-stagger-delay="60">
        {solucion.incluye.map((item, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{item}</h3></li>)}
      </ol>
      {solucion.servicioRelacionado && <p class="ss-relacionado">Complementa el proyecto con <a href={solucion.servicioRelacionado.href}>{solucion.servicioRelacionado.label}</a>.</p>}
    </section>
    {solucion.slug === 'capacitacion-ia-empresas' && <Programa />}

    <section class="ss-inversion" id="variables-inversion" data-template="pricing.html#prices">
      <div class="ss-inversion-head">
        <span class="bringer-label" data-appear="fade-up">Inversión</span>
        <h2 data-split-appear="fade-up" data-split-by="line">De qué depende<span class="bringer-accent">.</span></h2>
        <p class="bringer-large-text" data-appear="fade-up" data-delay="100">No creemos en paquetes cerrados que no se adaptan a tu empresa. La inversión parte de estos factores.</p>
        <a href="/inversion" class="bringer-arrow-link">Ver políticas de inversión</a>
      </div>
      <dl class="ss-factores" data-stagger-appear="fade-up" data-stagger-delay="60">
        {solucion.costoDepende.map((c) => <div><dt>{c.factor}</dt><dd>{c.impacto}</dd></div>)}
      </dl>
    </section>

    {(sectoresRelevantes.length > 0 || zonasRelevantes.length > 0) && (
      <section class="ss-explorar" id="explorar-soluciones" data-template="services.html#our-services">
        {sectoresRelevantes.length > 0 && <div><h2>Aplicaciones por sector</h2><div class="ss-enlaces">{sectoresRelevantes.map((sec) => <a href={`/sectores/${sec.slug}`}>{sec.nombre}<span aria-hidden="true">→</span></a>)}</div></div>}
        {zonasRelevantes.length > 0 && <div><h2>Zonas en Medellín</h2><div class="ss-enlaces">{zonasRelevantes.map((z) => <a href={`/medellin/${z.slug}`}>Empresas y comercios en {z.nombre}<span aria-hidden="true">→</span></a>)}</div></div>}
      </section>
    )}

    {solucion.slug === 'sitios-web-seo-geo' && <p class="geo-example-note">Trabajamos con las <a href="https://developers.google.com/search/docs/appearance/ai-features?hl=es" target="_blank" rel="noopener">recomendaciones de Google para funciones de IA en la Búsqueda</a>. No hay un marcado especial ni un archivo que garantice aparecer en sus respuestas.</p>}
    <!-- Section: Normativa -->
    <RelatedReading slugs={READINGS_BY_SOLUTION[solucion.slug] || []} />
    <Normativa claves={solucion.normativa} />

    <!-- Section: Preguntas Frecuentes Reales (Bringer Accordion) -->
    <FaqList faqs={solucion.faqs} titulo={`Preguntas frecuentes sobre ${solucion.nombre}`} categoria={solucion.nombre} />

    <!-- Section: Bento CTA Oficial Bringer -->
    <Cta 
      titulo={`¿Interesado en implementar ${solucion.nombre}?`}
      subtitulo="Revisamos tus flujos de trabajo actuales y te entregamos una propuesta con alcance, plazos y costos definidos."
      enlace={NEGOCIO.agenda}
    />
  </div>
</BaseLayout>
<script>
  // Dibuja la línea del proceso una sola vez, al entrar en pantalla.
  const proceso=document.querySelector<HTMLElement>('[data-ss-proceso]');
  if(proceso&&'IntersectionObserver' in window){
    const observer=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting)){proceso.classList.add('is-in');observer.disconnect();}},{threshold:.25});
    proceso.classList.add('is-ready');observer.observe(proceso);
  }
</script>
<style is:global>
  .ss-problema{padding:clamp(72px,10vw,140px) 0 clamp(24px,4vw,48px);scroll-margin-top:72px}.ss-frase{max-width:30ch;margin:16px 0 0;font-size:clamp(26px,3.5vw,46px);font-weight:600;line-height:1.16;letter-spacing:-.035em;color:var(--bringer-s-heading)}
  .ss-head{max-width:680px;margin-bottom:clamp(32px,5vw,64px)}.ss-head h2{margin:12px 0}.ss-head p{margin:0}
  .ss-proceso,.ss-incluye,.ss-inversion,.ss-explorar{padding:clamp(64px,9vw,120px) 0}
  .ss-steps{position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(0,1fr));grid-auto-flow:column;gap:clamp(20px,3vw,40px);margin:0;padding:0;list-style:none}.ss-steps::before{content:'';position:absolute;top:24px;left:0;right:0;height:2px;background:var(--ea-gradiente-diagonal);transform-origin:left}
  .ss-steps li{position:relative;margin:0;padding:0;list-style:none}.ss-steps li::marker{content:none}.ss-num{position:relative;display:grid;place-items:center;width:50px;height:50px;margin-bottom:20px;border-radius:15px;background:var(--ea-gradiente);color:#fff;font-size:18px;font-weight:600}.ss-steps h3{margin:0 0 8px;font-size:clamp(20px,2vw,26px);font-weight:600;line-height:1.2;letter-spacing:-.02em}.ss-steps p{margin:0;font-size:15px;line-height:1.5;color:var(--bringer-s-heading)}
  .ss-proceso.is-ready .ss-steps::before{transform:scaleX(0);transition:transform .9s cubic-bezier(.16,1,.3,1) .1s}.ss-proceso.is-ready .ss-steps li{opacity:0;transform:translateY(12px);transition:opacity .3s cubic-bezier(.16,1,.3,1),transform .3s cubic-bezier(.16,1,.3,1);transition-delay:calc(var(--i)*120ms + 150ms)}.ss-proceso.is-in .ss-steps::before{transform:none}.ss-proceso.is-in .ss-steps li{opacity:1;transform:none}
  .ss-list{margin:0;padding:0;list-style:none}.ss-list li{display:grid;grid-template-columns:clamp(44px,8vw,120px) minmax(0,1fr);gap:16px;margin:0;padding:clamp(18px,2.4vw,28px) 0;border-top:1px solid var(--bringer-s-border);list-style:none}.ss-list li::marker{content:none}.ss-list li>span{padding-top:.35em;font-size:14px;color:var(--bringer-s-text-accent)}.ss-list h3{margin:0;font-size:clamp(20px,2.6vw,34px);font-weight:600;line-height:1.18;letter-spacing:-.025em}.ss-relacionado{margin:24px 0 0;font-size:16px;color:var(--bringer-s-heading)}.ss-relacionado a{color:var(--bringer-s-text-accent);text-decoration:underline;text-underline-offset:.2em}
  .ss-inversion{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:clamp(32px,6vw,96px);align-items:start}.ss-inversion-head{position:sticky;top:110px}.ss-inversion-head h2{margin:12px 0}.ss-inversion-head p{margin:0 0 20px}.ss-factores{margin:0}.ss-factores>div{padding:clamp(18px,2.2vw,26px) 0;border-top:1px solid var(--bringer-s-border)}.ss-factores dt{margin:0 0 4px;font-size:clamp(20px,2.2vw,28px);font-weight:600;line-height:1.2;letter-spacing:-.02em;color:var(--bringer-s-heading)}.ss-factores dd{margin:0;font-size:15px;line-height:1.5;color:var(--bringer-s-heading-fade)}
  .ss-explorar{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:clamp(32px,5vw,72px)}.ss-explorar h2{margin:0 0 16px;font-size:clamp(24px,2.6vw,34px)}.ss-enlaces{display:flex;flex-direction:column}.ss-enlaces a{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:52px;padding:10px 2px;border-bottom:1px solid var(--bringer-s-border);color:var(--bringer-s-heading);font-size:16px;text-decoration:none;transition:color .15s}.ss-enlaces a span{color:var(--bringer-s-text-accent);transition:transform .15s}.ss-enlaces a:hover{color:var(--bringer-s-text-accent)}.ss-enlaces a:hover span{transform:translateX(4px)}
  @media(max-width:860px){.ss-steps{grid-auto-flow:row;grid-template-columns:minmax(0,1fr);gap:28px;padding-left:66px}.ss-steps::before{top:0;bottom:0;left:24px;right:auto;width:2px;height:auto;transform-origin:top}.ss-proceso.is-ready:not(.is-in) .ss-steps::before{transform:scaleY(0)}.ss-num{position:absolute;top:-4px;left:-66px;margin:0}.ss-inversion{grid-template-columns:minmax(0,1fr)}.ss-inversion-head{position:static}}
  @media(prefers-reduced-motion:reduce){.ss-proceso.is-ready .ss-steps::before,.ss-proceso.is-ready .ss-steps li{opacity:1;transform:none;transition:none}}
</style>
