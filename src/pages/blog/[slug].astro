---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import JsonLd from '../../components/geo/JsonLd.astro';
import blogData from '../../data/blog.json';
import { blogDestination, formatBlogDate } from '../../lib/blog';
import { ORG_ID, breadcrumbs } from '../../lib/schema';
export function getStaticPaths() { return blogData.map(post => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const destination = blogDestination(post.category, post.slug);
const related = blogData.filter(p => p.id !== post.id).sort((a, b) => Number(b.category === post.category) - Number(a.category === post.category) || b.date.localeCompare(a.date)).slice(0, 3);
const articleUrl = `https://edicionaular.com/blog/${post.slug}/`;
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', '@id': `${articleUrl}#article`,
  headline: post.title, description: post.excerpt, image: new URL(post.image, Astro.site).href,
  author: { '@type': 'Person', name: post.author || 'Edison Aular', url: 'https://edicionaular.com/nosotros/' },
  publisher: { '@id': ORG_ID }, datePublished: post.date, dateModified: post.dateModified || post.date,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl }, articleSection: post.category, inLanguage: 'es-CO',
};
---
<BaseLayout title={`${post.title} | Blog Edición Aular`} description={post.excerpt} image={post.image} type="article">
  <JsonLd slot="head" data={[articleSchema, breadcrumbs([{ name: 'Inicio', href: '/' }, { name: 'Blog', href: '/blog/' }, { name: post.title, href: `/blog/${post.slug}/` }])]} />
  <div class="stg-container blog-article">
    <article>
      <header class="article-header">
        <nav aria-label="Migas de pan"><a href="/">Inicio</a><span aria-hidden="true"> / </span><a href="/blog/">Blog</a><span aria-hidden="true"> / </span><span>{post.category}</span></nav>
        <h1 class="bringer-page-title">{post.title}</h1>
        <div class="article-meta"><a href="/nosotros/">Por {post.author}</a><span>Publicado: <time datetime={post.date}>{formatBlogDate(post.date)}</time></span>{post.dateModified && <span>Actualizado: <time datetime={post.dateModified}>{formatBlogDate(post.dateModified)}</time></span>}<span>{post.readTime} de lectura</span></div>
      </header>
      <figure class="article-image"><img src={post.image} alt={post.imageAlt || post.title} width="1200" height="630" decoding="async" /></figure>
      <div class="article-reading">
        <p class="article-excerpt bringer-large-text">{post.excerpt}</p>
        <div class="bringer-post-body" set:html={post.content} />
        <aside class="article-next bringer-block" aria-labelledby="article-next-title">
          <h2 id="article-next-title">Del artículo a tu proyecto</h2>
          <p>Si esta necesidad existe en tu negocio, revisemos el proceso, las herramientas y el alcance antes de elegir una solución.</p>
          <a href={destination.href} class="article-service">{destination.label} →</a>
          <a href="https://cal.com/edicion-aular-website" class="bringer-button">Conversar sobre mi proyecto</a>
        </aside>
      </div>
    </article>
    <section aria-labelledby="related-title"><h2 id="related-title">Lecturas relacionadas</h2><div class="related-grid">{related.map(item => <BlogCard post={item} />)}</div></section>
  </div>
</BaseLayout>
<style>
  .article-header { max-width: 960px; margin: auto; padding: 4rem 0 2rem; }
  nav { font-size: .9rem; margin-bottom: 1.5rem; overflow-wrap: anywhere; }
  .article-meta { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; border-top: 1px solid var(--bringer-s-border); padding-top: 1rem; color: var(--bringer-s-text); font-size: .85rem; }
  .article-meta a { color: var(--bringer-s-heading); }
  .article-image { max-width: 960px; margin: 0 auto 3rem; }
  .article-image img { display: block; width: 100%; height: auto; border-radius: 18px; }
  .article-reading { max-width: 780px; margin: auto; overflow-wrap: anywhere; }
  .article-excerpt { padding: 1.5rem; border-left: 3px solid var(--bringer-s-text-accent); background: var(--bringer-s-container-bg); border-radius: 8px; margin-bottom: 2rem; }
  .bringer-post-body { font-size: 1.05rem; line-height: 1.8; }
  .bringer-post-body :global(section) { padding: 0; }
  .bringer-post-body :global(h2) { font-size: 1.9rem; line-height: 1.35; margin: 3rem 0 1rem; }
  .bringer-post-body :global(h3) { font-size: 1.5rem; line-height: 1.4; margin: 2rem 0 1rem; }
  .bringer-post-body :global(h4) { font-size: 1.2rem; margin: 1.5rem 0 1rem; }
  .bringer-post-body :global(p), .bringer-post-body :global(ul), .bringer-post-body :global(ol) { margin-bottom: 1.5rem; }
  .bringer-post-body :global(li) { margin-bottom: .65rem; }
  .bringer-post-body :global(a), .article-service { color: var(--bringer-s-text-accent); text-decoration: underline; text-underline-offset: .2em; }
  .bringer-post-body :global(img) { max-width: 100%; height: auto; border-radius: 12px; }
  .bringer-post-body :global(table) { display: block; max-width: 100%; overflow-x: auto; }
  .article-next { margin: 3rem 0; }
  .article-next h2 { font-size: 1.6rem; }
  .article-next a { display: table; margin-top: 1.2rem; }
  .related-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.5rem; }
  .blog-article :global(a:focus-visible) { outline: 3px solid var(--bringer-s-text-accent); outline-offset: 4px; }
  @media(max-width: 750px) { .related-grid { grid-template-columns: minmax(0,1fr); } .article-header { padding-top: 2rem; } }
</style>
