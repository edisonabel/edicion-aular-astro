---
import { DEMO_DEFAULT, DEMO_ESPECIALIDADES, DEMO_ETAPAS, DEMO_SECTORS, getDemoSector } from '../lib/demo-atencion.js';
const { sector = DEMO_DEFAULT, titulo = 'Vive el recorrido completo', fijarSector = false } = Astro.props;
const inicial = getDemoSector(sector) ?? getDemoSector(DEMO_DEFAULT);
---
<section id="demo-atencion" class="demo-atencion" data-demo data-sector={inicial.id} data-fijar={fijarSector ? 'true' : undefined} data-template="propio#demo-atencion" aria-labelledby="demo-heading">
  <header class="demo-header">
    <span class="demo-eyebrow">DEMO SIMULADA · FUNCIONA CON REGLAS, SIN IA EN VIVO</span>
    <h2 id="demo-heading">{titulo}<span>.</span></h2>
    <p>Escribe como lo haría una persona real. Prueba, por ejemplo, “¿cuánto cuesta?” o “necesito hablar con alguien”. Nada de lo que escribas se guarda ni se envía.</p>
  </header>
  <div class="demo-controls">
    {!fijarSector && <div class="demo-chips" role="group" aria-label="Tipo de negocio">
      {DEMO_SECTORS.map(item=><button type="button" class="demo-chip" data-demo-chip={item.id} aria-pressed={item.id===inicial.id?'true':'false'}>{item.label}</button>)}
    </div>}
    <div class="demo-fields">
      <label class="demo-field" data-demo-especialidad-campo hidden={!inicial.salud}><span>Especialidad</span>
        <select data-demo-especialidad>{DEMO_ESPECIALIDADES.map(item=><option value={item.id}>{item.label}</option>)}</select>
      </label>
      <label class="demo-field"><span>Nombre de tu negocio (opcional)</span>
        <input type="text" maxlength="40" autocomplete="organization" placeholder="Clínica Vital" data-demo-negocio />
      </label>
    </div>
  </div>
  <ol class="demo-etapas" aria-label="Etapas del sistema" data-demo-etapas>
    {DEMO_ETAPAS.map((etapa,index)=><li data-demo-etapa={etapa}><span aria-hidden="true">{index+1}</span>{etapa}</li>)}
  </ol>
  <div class="demo-grid">
    <div class="demo-chat">
      <div class="demo-chat-top"><span class="demo-dot" aria-hidden="true"></span><strong data-demo-name>{inicial.label}</strong><small>Asistente de WhatsApp · ejemplo</small></div>
      <div class="demo-log" role="log" aria-live="polite" data-demo-log tabindex="0" aria-label="Conversación de la demo"></div>
      <div class="demo-options" data-demo-options></div>
      <form class="demo-composer" data-demo-form>
        <label class="demo-sr" for="demo-texto">Escribe tu mensaje</label>
        <input id="demo-texto" type="text" maxlength="160" autocomplete="off" placeholder="Escribe un mensaje…" data-demo-texto />
        <button type="submit" class="demo-send">Enviar</button>
      </form>
    </div>
    <div class="demo-side">
      <div class="demo-card">
        <h3>La ficha que ve tu equipo</h3>
        <dl class="demo-rows" data-demo-rows></dl>
      </div>
      <div class="demo-card">
        <h3>Lo que hizo el sistema</h3>
        <ol class="demo-eventos" data-demo-eventos></ol>
      </div>
    </div>
  </div>
  <div class="demo-fugas">
    <div class="demo-card">
      <h3>¿Dónde se te van hoy?</h3>
      <p class="demo-help">Cambia los valores de ejemplo por los de tu negocio.</p>
      <label class="demo-range"><span>Consultas al mes</span><input type="range" min="20" max="1000" step="10" value="200" data-demo-consultas /><output data-demo-consultas-valor></output></label>
      <label class="demo-range"><span>De ellas, agendan</span><input type="range" min="5" max="100" step="5" value="40" data-demo-agendan /><output data-demo-agendan-valor></output></label>
      <label class="demo-range"><span>De las citas, no asisten</span><input type="range" min="0" max="60" step="5" value="20" data-demo-noasisten /><output data-demo-noasisten-valor></output></label>
      <label class="demo-range"><span>Valor promedio por atención</span><input type="range" min="50000" max="2000000" step="50000" value="150000" data-demo-valor /><output data-demo-valor-valor></output></label>
    </div>
    <div class="demo-card demo-resultado" aria-live="polite">
      <h3>Con esos números, cada mes</h3>
      <p><strong data-demo-sincita></strong> consultas no llegan a una cita.</p>
      <p><strong data-demo-perdidas></strong> citas agendadas no se atienden.</p>
      <p><strong data-demo-dinero></strong> equivalen a esas citas no atendidas.</p>
      <p class="demo-help">Es solo un cálculo con tus números. No es una promesa de resultado.</p>
      <button type="button" class="demo-primary" data-demo-whatsapp data-contact-channel="whatsapp">Quiero este sistema <span aria-hidden="true">↗</span></button>
      <p class="demo-help">El mensaje queda preparado. Tú decides cuándo enviarlo.</p>
    </div>
  </div>
  <noscript><p>Puedes <a href="https://wa.me/573002730128">escribirnos por WhatsApp</a> o <a href="https://cal.com/edicion-aular-website">agendar una conversación</a>.</p></noscript>
</section>
<script>
  import { DEMO_DEFAULT, DEMO_ESPECIALIDADES, DEMO_RECORRIDO, demoEtapa, demoFugas, demoIniciar, demoResponder, demoWhatsapp, getDemoEspecialidad, getDemoSector, limpiarNegocio } from '../lib/demo-atencion.js';
  const root=document.querySelector<HTMLElement>('[data-demo]');
  if(root){
    const q=<T extends Element>(selector:string)=>root.querySelector<T>(selector)!;
    const log=q<HTMLElement>('[data-demo-log]'),options=q<HTMLElement>('[data-demo-options]'),rows=q<HTMLElement>('[data-demo-rows]'),eventos=q<HTMLElement>('[data-demo-eventos]');
    const form=q<HTMLFormElement>('[data-demo-form]'),texto=q<HTMLInputElement>('[data-demo-texto]'),selector=q<HTMLSelectElement>('[data-demo-especialidad]'),negocio=q<HTMLInputElement>('[data-demo-negocio]');
    const campos={consultas:q<HTMLInputElement>('[data-demo-consultas]'),agendan:q<HTMLInputElement>('[data-demo-agendan]'),noAsisten:q<HTMLInputElement>('[data-demo-noasisten]'),valor:q<HTMLInputElement>('[data-demo-valor]')};
    const pausa=matchMedia('(prefers-reduced-motion: reduce)').matches?0:650,moneda=new Intl.NumberFormat('es-CO',{style:'currency',currency:'COP',maximumFractionDigits:0});
    let sectorId=root.dataset.sector||DEMO_DEFAULT,actual:any=null,turno=0,ocupado=false,usoIndicado=false,hayInteraccion=false,fase='chat',recorrido=0,extras:Record<string,string>={},eventosExtra:string[]=[];
    // Un enlace puede preparar la demo para un prospecto: ?negocio=Clínica%20Vital&especialidad=estetica&sector=inmobiliarias
    const pedido=new URLSearchParams(location.search);
    if(root.dataset.fijar!=='true'&&getDemoSector(pedido.get('sector')||''))sectorId=pedido.get('sector')!;
    if(getDemoEspecialidad(pedido.get('especialidad')||''))selector.value=pedido.get('especialidad')!;
    negocio.value=limpiarNegocio(pedido.get('negocio'));
    const hora=()=>new Date().toLocaleTimeString('es-CO',{hour:'numeric',minute:'2-digit'});
    function mensaje(contenido:string,clase:string){
      const p=document.createElement('div');p.className=`demo-msg ${clase}`;
      const cuerpo=document.createElement('span');cuerpo.textContent=contenido;
      const meta=document.createElement('small');meta.textContent=clase==='is-user'?`${hora()} ✓✓`:hora();
      p.append(cuerpo,meta);log.append(p);log.scrollTop=log.scrollHeight;return p;
    }
    function separador(contenido:string){const p=document.createElement('p');p.className='demo-dia';p.textContent=contenido;log.append(p);log.scrollTop=log.scrollHeight;}
    function marcarEtapas(hasta:string[]){
      root!.querySelectorAll<HTMLElement>('[data-demo-etapa]').forEach(item=>{const activa=hasta.includes(item.dataset.demoEtapa!);item.classList.toggle('is-done',activa);if(item.dataset.demoEtapa===hasta[hasta.length-1])item.setAttribute('aria-current','step');else item.removeAttribute('aria-current');});
    }
    function pintarPaneles(){
      const {state,pasos}=actual,filas:[string,string,string?][]=[['Origen',state.motivo?`Anuncio de ejemplo · ${state.motivo}`:'Anuncio de ejemplo']];
      pasos.forEach((key:string,index:number)=>filas.push([key,state.ficha[key]??(state.fin?'No hace falta':index===state.paso?'Esperando respuesta…':'Pendiente')]));
      filas.push(['Prioridad',state.prioridad||'Pendiente',state.prioridad?(state.prioridad.startsWith('Urgente')?'is-urgent':'is-ready'):'']);
      Object.entries(extras).forEach(([key,value])=>filas.push([key,value]));
      rows.replaceChildren(...filas.flatMap(([key,value,clase])=>{const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=key;dd.textContent=value;if(clase)dd.className=clase;return [dt,dd];}));
      const lista=[...state.eventos,...eventosExtra];
      eventos.replaceChildren(...(lista.length?lista:['Esperando el primer mensaje…']).map((item:string)=>{const li=document.createElement('li');li.textContent=item;if(!lista.length)li.className='is-empty';return li;}));
      eventos.scrollTop=eventos.scrollHeight;
    }
    function botones(lista:string[],accion:(valor:string)=>void){
      options.replaceChildren(...lista.map(valor=>{const b=document.createElement('button');b.type='button';b.className='demo-option';b.textContent=valor;b.addEventListener('click',()=>{hayInteraccion=true;accion(valor);});return b;}));
      if(hayInteraccion&&document.activeElement!==texto)options.querySelector('button')?.focus({preventScroll:true});
    }
    function escribir(respuestas:string[],despues:()=>void){
      const este=turno;ocupado=true;options.replaceChildren();
      const siguiente=(index:number)=>{
        if(este!==turno)return;
        if(index>=respuestas.length){ocupado=false;despues();return;}
        const p=document.createElement('div');p.className='demo-msg is-bot is-typing';p.setAttribute('aria-label','Escribiendo');p.innerHTML='<i></i><i></i><i></i>';log.append(p);log.scrollTop=log.scrollHeight;
        setTimeout(()=>{if(este!==turno)return;p.remove();mensaje(respuestas[index],'is-bot');siguiente(index+1);},pausa);
      };
      siguiente(0);
    }
    function ofrecer(){
      pintarPaneles();
      if(!actual.state.fin){botones(actual.quick,responderTexto);return;}
      marcarEtapas(actual.state.cita?['Atraer','Responder','Agendar']:['Atraer','Responder']);
      fase='recorrido';recorrido=0;
      botones(['Ver qué pasa después','Probar de nuevo'],valor=>valor==='Probar de nuevo'?iniciar():avanzarRecorrido());
    }
    function responderTexto(valor:string){
      mensaje(valor,'is-user');actual=demoResponder(actual.state,valor);pintarPaneles();
      if(actual.state.cita)marcarEtapas(['Atraer','Responder','Agendar']);
      escribir(actual.replies,ofrecer);
    }
    function avanzarRecorrido(){
      if(recorrido>=DEMO_RECORRIDO.length){
        fase='fin';marcarEtapas(['Atraer','Responder','Agendar','Confirmar','Cuidar','Volver','Medir']);
        eventosExtra.push('Sumó este recorrido al reporte de la clínica');pintarPaneles();
        separador('Reporte para tu equipo');
        escribir(['Cada mes ves cuántas consultas llegaron, por qué canal, cuántas agendaron, cuántas asistieron y cuántas volvieron.'],()=>botones(['Probar de nuevo'],()=>iniciar()));
        return;
      }
      const etapa=demoEtapa(DEMO_RECORRIDO[recorrido],actual.state),nombres=['Atraer','Responder','Agendar','Confirmar','Cuidar','Volver'];
      marcarEtapas(nombres.slice(0,nombres.indexOf(etapa.etapa)+1));
      separador(etapa.dia);
      escribir([etapa.text],()=>botones(Object.keys(etapa.opciones),valor=>{
        const opcion=etapa.opciones[valor];
        mensaje(valor,'is-user');extras[etapa.campo]=opcion.ficha;eventosExtra.push(...opcion.eventos);pintarPaneles();recorrido++;
        escribir([opcion.reply],()=>botones([recorrido>=DEMO_RECORRIDO.length?'Ver el reporte':'Seguir el recorrido'],()=>avanzarRecorrido()));
      }));
    }
    function iniciar(){
      turno++;ocupado=false;fase='chat';recorrido=0;extras={};eventosExtra=[];log.replaceChildren();options.replaceChildren();
      const sector=getDemoSector(sectorId)!;
      actual=demoIniciar({sectorId,especialidadId:selector.value||DEMO_ESPECIALIDADES[0].id,negocio:negocio.value});
      q('[data-demo-name]').textContent=limpiarNegocio(negocio.value)||sector.label;
      q<HTMLElement>('[data-demo-especialidad-campo]').hidden=!sector.salud;
      root!.querySelectorAll<HTMLElement>('[data-demo-chip]').forEach(chip=>chip.setAttribute('aria-pressed',String(chip.dataset.demoChip===sectorId)));
      marcarEtapas(['Atraer','Responder']);pintarPaneles();
      escribir(actual.replies,ofrecer);
    }
    function calcular(){
      const datos={consultas:Number(campos.consultas.value),agendan:Number(campos.agendan.value),noAsisten:Number(campos.noAsisten.value),valor:Number(campos.valor.value)},r=demoFugas(datos);
      q('[data-demo-consultas-valor]').textContent=String(datos.consultas);q('[data-demo-agendan-valor]').textContent=`${datos.agendan} %`;q('[data-demo-noasisten-valor]').textContent=`${datos.noAsisten} %`;q('[data-demo-valor-valor]').textContent=moneda.format(datos.valor);
      q('[data-demo-sincita]').textContent=String(r.sinCita);q('[data-demo-perdidas]').textContent=String(r.perdidas);q('[data-demo-dinero]').textContent=moneda.format(r.valorPerdido);
      return datos;
    }
    Object.values(campos).forEach(input=>input.addEventListener('input',()=>{usoIndicado=true;calcular();}));
    form.addEventListener('submit',event=>{
      event.preventDefault();const valor=texto.value.trim();if(!valor||ocupado)return;texto.value='';hayInteraccion=true;
      if(fase==='chat'){responderTexto(valor);return;}
      mensaje(valor,'is-user');escribir(['En esta parte de la demo elige una de las opciones. En un proyecto, el asistente también entiende mensajes escritos.'],()=>{const actuales=options.children.length;if(!actuales){if(fase==='fin')botones(['Probar de nuevo'],()=>iniciar());else if(recorrido===0)botones(['Ver qué pasa después','Probar de nuevo'],v=>v==='Probar de nuevo'?iniciar():avanzarRecorrido());else botones(['Seguir el recorrido'],()=>avanzarRecorrido());}});
    });
    root.querySelectorAll<HTMLElement>('[data-demo-chip]').forEach(chip=>chip.addEventListener('click',()=>{hayInteraccion=true;sectorId=chip.dataset.demoChip!;iniciar();}));
    selector.addEventListener('change',iniciar);negocio.addEventListener('change',iniciar);
    negocio.addEventListener('input',()=>{q('[data-demo-name]').textContent=limpiarNegocio(negocio.value)||getDemoSector(sectorId)!.label;});
    // Como en el orientador: el botón no expone la URL con respuestas a la medición automática de enlaces.
    q('[data-demo-whatsapp]').addEventListener('click',()=>{
      const datos=calcular();window.location.assign(demoWhatsapp({sectorId,especialidadId:selector.value,negocio:negocio.value},usoIndicado?datos:undefined).whatsapp);
    });
    calcular();iniciar();
  }
</script>
<style>
  .demo-atencion{--demo-bg:#15171c;--demo-card:#1d2026;--demo-text:#f5f5f7;--demo-muted:#b6b9c3;--demo-border:#3c404b;--demo-selected:#30212b;--demo-accent:#ff80ad;box-sizing:border-box;margin:48px 0 64px;padding:28px;border:1px solid var(--demo-border);border-radius:24px;background:var(--demo-bg);color:var(--demo-text);scroll-margin-top:96px}
  :global(html.light-mode) .demo-atencion{--demo-bg:#fff;--demo-card:#f7f7f9;--demo-text:#20232b;--demo-muted:#5c6270;--demo-border:#d8dbe2;--demo-selected:#fff0f5;--demo-accent:#b80046}
  .demo-atencion [hidden]{display:none!important}
  .demo-header{margin:0 0 18px}.demo-eyebrow{display:block;font-size:10px;letter-spacing:.14em;line-height:1.6;font-weight:600;color:var(--demo-muted)}.demo-header h2{margin:6px 0 8px;font-size:clamp(24px,3vw,32px);line-height:1.25;letter-spacing:-.035em;color:var(--demo-text)}.demo-header h2 span{color:var(--demo-accent)}.demo-header p{margin:0;max-width:66ch;font-size:15px;line-height:1.6;color:var(--demo-muted)}
  .demo-controls{display:flex;flex-direction:column;gap:12px;margin:0 0 16px}.demo-chips{display:flex;flex-wrap:wrap;gap:8px}.demo-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.demo-field{display:flex;flex-direction:column;gap:6px;margin:0;font-size:13px;font-weight:400;letter-spacing:normal;text-transform:none;color:var(--demo-muted)}
  .demo-atencion .demo-field :is(input,select),.demo-atencion .demo-composer input{width:100%;min-height:44px;margin:0;padding:10px 12px;box-sizing:border-box;border:1px solid var(--demo-border);border-radius:9px;background:var(--demo-card);color:var(--demo-text);font:inherit;font-size:16px;line-height:1.3;letter-spacing:normal;text-transform:none;box-shadow:none;appearance:auto}.demo-atencion input::placeholder{color:var(--demo-muted);opacity:1}
  .demo-atencion .demo-chip,.demo-atencion :global(.demo-option),.demo-atencion .demo-send{display:inline-flex;align-items:center;min-height:44px;margin:0;padding:8px 14px;box-sizing:border-box;border:1px solid var(--demo-border);border-radius:9px;background:transparent;color:var(--demo-text);font:inherit;font-size:14px;font-weight:500;line-height:1.3;letter-spacing:0;text-transform:none;text-align:left;white-space:normal;cursor:pointer;transition:border-color .15s,background .15s}.demo-atencion .demo-chip:hover,.demo-atencion :global(.demo-option:hover),.demo-atencion .demo-send:hover{border-color:var(--demo-accent);background:var(--demo-selected);color:var(--demo-text)}.demo-atencion .demo-chip[aria-pressed="true"]{border-color:var(--demo-accent);background:var(--demo-selected);box-shadow:inset 0 0 0 1px var(--demo-accent)}
  .demo-etapas{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;list-style:none;margin:0 0 16px;padding:0}.demo-etapas li{display:flex;align-items:center;gap:6px;min-width:0;padding:8px 0 0;border-top:3px solid var(--demo-border);font-size:12px;line-height:1.3;color:var(--demo-muted);transition:color .2s,border-color .2s}.demo-etapas li span{font-size:10px}.demo-etapas li.is-done{border-color:var(--demo-accent);color:var(--demo-text)}.demo-etapas li[aria-current]{font-weight:600}
  .demo-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:16px;align-items:stretch}.demo-chat,.demo-card{border:1px solid var(--demo-border);border-radius:16px;background:var(--demo-card)}
  .demo-chat{display:flex;flex-direction:column;min-width:0;overflow:hidden}.demo-chat-top{display:flex;flex-wrap:wrap;align-items:center;gap:2px 8px;padding:12px 16px;border-bottom:1px solid var(--demo-border);font-size:14px}.demo-chat-top strong{color:var(--demo-text);font-weight:600}.demo-chat-top small{width:100%;margin-left:16px;font-size:12px;color:var(--demo-muted)}.demo-dot{width:8px;height:8px;border-radius:50%;background:var(--demo-accent)}
  .demo-log{display:flex;flex-direction:column;gap:8px;flex:1 1 auto;height:380px;padding:16px;overflow-y:auto;overscroll-behavior:contain}.demo-log:focus-visible{outline-offset:-3px}.demo-log :global(.demo-msg){display:flex;flex-direction:column;gap:2px;max-width:85%;padding:9px 13px;border-radius:14px;font-size:14px;line-height:1.45;color:var(--demo-text)}.demo-log :global(.demo-msg small){align-self:flex-end;font-size:10px;line-height:1.2;color:var(--demo-muted)}.demo-log :global(.is-bot){align-self:flex-start;background:var(--demo-bg);border:1px solid var(--demo-border)}.demo-log :global(.is-user){align-self:flex-end;background:var(--demo-selected);border:1px solid var(--demo-accent)}.demo-log :global(.is-typing){flex-direction:row;gap:4px;padding:13px}.demo-log :global(.is-typing i){width:6px;height:6px;border-radius:50%;background:var(--demo-muted);animation:demo-punto 1s infinite}.demo-log :global(.is-typing i:nth-child(2)){animation-delay:.15s}.demo-log :global(.is-typing i:nth-child(3)){animation-delay:.3s}.demo-log :global(.demo-dia){align-self:center;margin:6px 0;padding:3px 10px;border:1px solid var(--demo-border);border-radius:20px;font-size:11px;line-height:1.5;color:var(--demo-muted)}
  @keyframes demo-punto{0%,60%,100%{opacity:.35}30%{opacity:1}}
  .demo-options{display:flex;flex-wrap:wrap;gap:8px;padding:12px 16px 0;box-sizing:border-box;border-top:1px solid var(--demo-border);min-height:57px}.demo-composer{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;padding:12px 16px}
  .demo-side{display:flex;flex-direction:column;gap:12px;min-width:0}.demo-card{padding:16px}.demo-card h3{margin:0 0 12px;font-size:16px;font-weight:600;line-height:1.35;letter-spacing:-.01em;color:var(--demo-text)}.demo-rows{display:grid;grid-template-columns:auto minmax(0,1fr);gap:0;margin:0;font-size:13px;line-height:1.4}.demo-rows :global(dt),.demo-rows :global(dd){margin:0;padding:6px 0;border-top:1px solid var(--demo-border)}.demo-rows :global(dt:first-child),.demo-rows :global(dt:first-child+dd){border-top:0}.demo-rows :global(dt){color:var(--demo-muted);font-weight:400}.demo-rows :global(dd){padding-left:16px;text-align:right;color:var(--demo-text)}.demo-rows :global(dd.is-ready){color:var(--demo-accent);font-weight:600}.demo-rows :global(dd.is-urgent){color:var(--demo-accent);font-weight:700}
