---
import { formatBlogDate } from '../../lib/blog';
const { post } = Astro.props;
---
<article class="blog-card bringer-block">
  <img src={post.image} alt={post.imageAlt || post.title} width="800" height="450" loading="lazy" decoding="async" />
  <div class="blog-card-copy">
    <span class="blog-category">{post.category}</span>
    <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
    <p>{post.excerpt}</p>
    <div class="blog-card-meta"><time datetime={post.date}>{formatBlogDate(post.date)}</time><span>{post.readTime} de lectura</span></div>
  </div>
</article>
<style>
  .blog-card { padding: 0; overflow: hidden; height: 100%; display: flex; flex-direction: column; }
  .blog-card > img { width: 100%; aspect-ratio: 16/9; height: auto; object-fit: cover; }
  .blog-card-copy { padding: 1.5rem; display: flex; flex: 1; flex-direction: column; gap: 1rem; }
  .blog-category { color: var(--bringer-s-text-accent); font-size: .8rem; font-weight: 600; }
  h3 { font-size: 1.25rem; line-height: 1.4; margin: 0; }
  h3 a { color: var(--bringer-s-heading); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: .2em; }
  h3 a:focus-visible { outline: 3px solid var(--bringer-s-text-accent); outline-offset: 4px; }
  p { font-size: .95rem; line-height: 1.65; margin: 0; color: var(--bringer-s-text); }
  .blog-card-meta { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--bringer-s-border); display: flex; flex-wrap: wrap; gap: .5rem 1rem; color: var(--bringer-s-text); font-size: .8rem; }
</style>
