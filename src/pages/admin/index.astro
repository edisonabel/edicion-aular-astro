---
// Static shell only. Article data and every mutation require server-side authorization.
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="robots" content="noindex, nofollow"/><meta name="description" content="Panel privado de revisión y publicación editorial de Edición Aular."/>
  <link rel="canonical" href="https://edicionaular.com/admin/"/><link rel="icon" href="/favicon.svg"/>
  <title>Estudio editorial | Edición Aular</title>
</head>
<body>
  <header><a href="/" class="brand">EDICIÓN<span>AULAR</span></a><span class="private">Estudio editorial · privado</span><button id="theme" aria-label="Cambiar tema">Modo claro</button><button id="logout" hidden>Salir</button></header>
  <main>
    <section id="login-panel" class="login-card">
      <p class="eyebrow">TU CONTENIDO, CON CRITERIO</p><h1>Del borrador<br/>a una buena publicación<span>.</span></h1>
      <p class="intro">Revisa el texto, sus fuentes y la portada. Publica cuando esté listo.</p>
      <form id="login-form"><label>Correo<input id="login-email" type="email" autocomplete="username" required value="edicionaular@gmail.com"/></label><label>Contraseña<input id="login-password" type="password" autocomplete="current-password" required minlength="8"/></label><button class="primary" type="submit">Entrar al estudio <span aria-hidden="true">↗</span></button></form>
      <form id="invite-form" hidden><label>Crea tu contraseña<input id="invite-password" type="password" autocomplete="new-password" required minlength="12"/></label><label>Repite la contraseña<input id="invite-confirm" type="password" autocomplete="new-password" required minlength="12"/></label><button class="primary" type="submit">Activar mi acceso</button></form>
      <button id="recovery" class="text-button">Recuperar mi acceso</button><p class="small">Acceso por invitación. El contenido editorial requiere una cuenta autorizada.</p>
    </section>
    <section id="workspace" hidden>
      <div class="workspace-heading"><div><p class="eyebrow">EDICIÓN AULAR / CONTENIDO</p><h1>Tu próxima publicación<span>.</span></h1></div><button id="reload">Actualizar listado</button></div>
      <div class="studio-grid"><aside><h2>Borradores</h2><label class="mobile-picker">Elegir artículo<select id="draft-picker"></select></label><nav id="draft-list" aria-label="Artículos pendientes"></nav></aside>
        <section id="editor" hidden aria-labelledby="editor-heading">
          <div class="editor-heading"><p id="entry-kind" class="eyebrow"></p><h2 id="editor-heading"></h2><p id="entry-status" class="small"></p></div>
          <div class="tabs" role="tablist" aria-label="Vista del artículo"><button id="tab-preview" role="tab" aria-selected="true" aria-controls="preview-panel">Vista previa</button><button id="tab-edit" role="tab" aria-selected="false" aria-controls="edit-panel" tabindex="-1">Editar texto</button></div>
          <div id="preview-panel" role="tabpanel" aria-labelledby="tab-preview"><iframe id="preview" title="Vista previa del artículo" sandbox="allow-same-origin"></iframe></div>
          <div id="edit-panel" role="tabpanel" aria-labelledby="tab-edit" hidden><label>Título<input id="post-title" maxlength="120"/></label><label>Resumen<textarea id="post-excerpt" rows="3" maxlength="240"></textarea></label><label>Texto del artículo · HTML sencillo<textarea id="post-content" rows="20" spellcheck="true"></textarea></label><p class="small">Se conservan párrafos, títulos, listas, tablas y enlaces. Se retiran scripts, formularios y estilos ajenos.</p></div>
          <details class="sources"><summary>Fuentes para comprobar antes de publicar</summary><ul id="source-list"></ul></details>
          <div class="publish-bar"><p id="dirty-note" class="small"></p><button id="save">Guardar borrador</button><button id="review" class="primary">Revisar y publicar <span aria-hidden="true">↗</span></button></div>
        </section>
      </div>
    </section>
    <p id="message" role="status" aria-live="polite"></p>
  </main>
  <dialog id="publish-dialog" aria-labelledby="publish-title"><form method="dialog"><button class="dialog-close" aria-label="Cerrar revisión">×</button></form><p class="eyebrow">ÚLTIMA REVISIÓN</p><h2 id="publish-title">¿Está listo para salir?</h2><p id="publish-summary"></p><label class="check"><input id="check-sources" type="checkbox"/>Comprobé las fuentes, las fechas y el estado beta cuando corresponde.</label><label class="check"><input id="check-content" type="checkbox"/>Leí el artículo y revisé sus ejemplos, enlaces y afirmaciones.</label><label class="check"><input id="check-image" type="checkbox"/>La portada corresponde al tema y está identificada como ilustración con IA.</label><p class="small">Publicar guarda este artículo en GitHub y activa la compilación de Netlify. La web se actualiza cuando el despliegue termina.</p><button id="publish" class="primary" disabled>Publicar artículo</button></dialog>
  <script src="../../lib/editorial-panel.js"></script>
</body>
</html>
<style is:global>
  :root{font-family:Inter,system-ui,sans-serif;color:#24242c;background:#f5f4f4;--accent:#b80046;--line:#dddde2;--muted:#62626c;--surface:white}*{box-sizing:border-box}body{margin:0}button,input,textarea{font:inherit}button,a,input,textarea,summary{outline-offset:4px}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid var(--accent)}button{cursor:pointer;border:1px solid var(--line);background:var(--surface);color:inherit;padding:.8rem 1.1rem;border-radius:9px;font-weight:600}button:disabled{opacity:.55;cursor:not-allowed}.primary{background:var(--accent);border-color:var(--accent);color:#fff;display:inline-flex;align-items:center;justify-content:space-between;gap:1.5rem}.primary:hover{background:#990039}header{display:flex;align-items:center;gap:1.5rem;padding:1.25rem 5vw;border-bottom:1px solid var(--line);background:var(--surface)}header #theme{margin-left:auto;font-size:.75rem;padding:.5rem .7rem}header #logout{font-size:.75rem;padding:.5rem .7rem}.brand{font-weight:850;letter-spacing:.06em;color:var(--accent);text-decoration:none;font-size:1.1rem}.brand span{font-weight:400;display:block;letter-spacing:.6em;font-size:.58rem}.private{font-size:.8rem;color:var(--muted)}main{max-width:1440px;margin:0 auto;padding:3.5rem 5vw}h1{font-size:clamp(2.2rem,4vw,4rem);line-height:1.1;letter-spacing:-.045em;margin:1rem 0}h1 span{color:var(--accent)}h2{font-size:1.25rem;line-height:1.35;letter-spacing:-.02em}.eyebrow{font-size:.7rem;font-weight:750;letter-spacing:.12em;color:var(--muted)}.intro{color:var(--muted);font-size:1.1rem;line-height:1.7;max-width:460px}.login-card{max-width:670px;padding:2rem 0}form{max-width:430px}label{display:block;font-size:.85rem;font-weight:600;margin:1.2rem 0}input,textarea{display:block;width:100%;border:1px solid var(--line);background:var(--surface);color:inherit;border-radius:8px;padding:.9rem;margin-top:.5rem;line-height:1.6}textarea{resize:vertical}input[type=checkbox]{width:18px;height:18px;flex-shrink:0;accent-color:var(--accent);margin:0}.small{color:var(--muted);font-size:.8rem;line-height:1.7}.text-button{padding:.75rem 0;background:none;border:0;color:var(--muted);text-decoration:underline;margin-top:.5rem}#message{max-width:850px;line-height:1.6;padding:1rem 0;font-weight:550}#message[data-error=true]{color:#a82037}.workspace-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:2rem}.workspace-heading h1{font-size:clamp(2rem,3vw,3rem)}.studio-grid{display:grid;grid-template-columns:280px minmax(0,1fr);gap:2rem}.studio-grid aside{min-width:0}.mobile-picker{display:none}.mobile-picker select{display:block;width:100%;max-width:100%;padding:.85rem;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:inherit;font:inherit}.studio-grid aside h2{font-size:.85rem;color:var(--muted)}#draft-list{display:grid;gap:.75rem}#draft-list button{padding:1.2rem;text-align:left;line-height:1.5;font-size:.9rem}#draft-list button[aria-current=true]{border-color:var(--accent);box-shadow:inset 3px 0 var(--accent)}#draft-list small{display:block;font-size:.7rem;color:var(--muted);margin-top:.6rem}#editor{min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden}.editor-heading{padding:1.25rem 1.5rem}.editor-heading h2{font-size:1.4rem;margin:.6rem 0}.tabs{display:flex;gap:.5rem;padding:0 1.5rem 1rem;border-bottom:1px solid var(--line)}.tabs button{border:0;background:transparent;color:var(--muted)}.tabs button[aria-selected=true]{background:var(--accent);color:white}iframe{border:0;width:100%;min-height:500px;height:800px;display:block;background:white}#edit-panel{padding:0 1.5rem}#post-content{font: .83rem/1.7 ui-monospace,monospace}.sources{padding:1.25rem 1.5rem;border-top:1px solid var(--line)}.sources summary{cursor:pointer;font-size:.85rem;font-weight:650}.sources li{margin:1rem 0;font-size:.85rem;line-height:1.7}.sources a{color:var(--accent);overflow-wrap:anywhere}.publish-bar{display:flex;justify-content:flex-end;gap:.75rem;align-items:center;flex-wrap:wrap;padding:1.25rem 1.5rem;border-top:1px solid var(--line)}.publish-bar p{flex-basis:100%;margin:0}dialog{border:1px solid var(--line);border-radius:16px;max-width:570px;width:calc(100% - 2rem);padding:2rem;color:inherit;background:var(--surface)}dialog::backdrop{background:#0d0d14a6}.dialog-close{float:right;font-size:1.5rem;border:0;padding:0 .4rem}.check{display:flex;align-items:flex-start;gap:.75rem;line-height:1.6;font-weight:450}.check input{margin-top:.2rem}[hidden]{display:none!important}@media(max-width:900px){.studio-grid{grid-template-columns:1fr}#draft-list{grid-template-columns:repeat(3,1fr)}main{padding:2rem 4vw}header{padding:1rem 4vw}.workspace-heading{align-items:flex-start}iframe{height:700px}}@media(max-width:600px){header{gap:.75rem}.private{order:3;flex-basis:100%}.mobile-picker{display:block}#draft-list{display:none}.private{font-size:.7rem}.workspace-heading{flex-direction:column}.publish-bar button{flex-grow:1}.login-card{padding:0}h1{font-size:2.4rem}}
  header{flex-wrap:wrap}select:focus-visible{outline:3px solid var(--accent);outline-offset:4px}
  :root[data-theme=dark]{background:#111217;color:#f2f2f5;--surface:#1a1c24;--line:#343642;--muted:#b5b5c2;--accent:#dd1b65}:root[data-theme=dark] #message[data-error=true]{color:#ffafbb}
</style>
