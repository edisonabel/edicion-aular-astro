---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/geo/JsonLd.astro';
import Cta from '../components/geo/Cta.astro';
import FaqList from '../components/geo/FaqList.astro';
import SistemaEquipo from '../components/SistemaEquipo.astro';
import SistemaFundadoras from '../components/SistemaFundadoras.astro';
import { FAQS_SISTEMA } from '../data/ia/sistema-oferta';
import DemoAtencion from '../components/DemoAtencion.astro';
import SistemaFlujo from '../components/SistemaFlujo.astro';
import SistemaFugas from '../components/SistemaFugas.astro';
import SistemaHero from '../components/SistemaHero.astro';
import SistemaRostro from '../components/SistemaRostro.astro';
import { NEGOCIO } from '../data/ia/negocio';
import { breadcrumbs, faqPage, service, webPage } from '../lib/schema';

const title = 'Sistema de pacientes para clínicas y estética en Medellín';
const description = 'Un sistema para clínicas, consultorios y centros de estética: atrae pacientes, responde por WhatsApp, agenda, confirma, cuida, los hace volver y mide cada paso.';
const pageUrl = '/sistema-clinicas';
const schemaData = [
  webPage({ name: title, description, path: pageUrl }),
  service({ name: 'Sistema de pacientes para clínicas y estética', description, path: pageUrl, audience: 'Clínicas, consultorios y centros de estética' }),
  breadcrumbs([
    { name: 'Inicio', href: '/' },
    { name: 'Sistema de pacientes', href: pageUrl }
  ]),
  faqPage(FAQS_SISTEMA)
];
---

<BaseLayout title={title} description={description} image="/img/ia/hero-sistema.webp">
  <JsonLd slot="head" data={schemaData} />

  <div class="stg-container">
    <SistemaHero />
    <SistemaFlujo />
    <SistemaRostro />
    <DemoAtencion titulo="Vive el recorrido de un paciente" />
    <SistemaFugas />

    <SistemaFundadoras />
    <SistemaEquipo />
    <FaqList faqs={FAQS_SISTEMA} titulo="Preguntas frecuentes sobre el sistema" categoria="Sistema de pacientes" />

    <Cta
      titulo="¿Dónde está perdiendo pacientes tu clínica?"
      subtitulo="Agenda una conversación gratis de 15 minutos. Revisamos cómo llegan tus consultas y por cuál etapa conviene empezar."
      enlace={NEGOCIO.agenda}
    />
  </div>
</BaseLayout>
