---
import { NEGOCIO } from '../data/ia/negocio';
const avisos = [
  { titulo: 'Nueva consulta', texto: 'Limpieza facial · desde un anuncio', clase: 'is-a', icono: '<path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4V6a1 1 0 0 1 1-1Z"/><path d="M8 10h8M8 13h5"/>' },
  { titulo: 'Cita confirmada', texto: 'Mañana, 9:00 a. m.', clase: 'is-b', icono: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M9 15.5l2 2 4-4"/>' },
  { titulo: 'Espacio recuperado', texto: 'Lo tomó la lista de espera', clase: 'is-c', icono: '<path d="M20 11a8 8 0 0 0-14.3-4L3 9.5"/><path d="M3 4v5.5h5.5"/><path d="M4 13a8 8 0 0 0 14.3 4l2.7-2.5"/><path d="M21 20v-5.5h-5.5"/>' },
];
---
<section class="sh backlight-bottom" id="sistema-hero">
  <div class="bringer-hero-block bringer-hero-type03">
    <div class="sh-top">
      <div class="sh-in">
        <span class="bringer-label">Sistema de pacientes · Salud y estética</span>
        <h1 class="bringer-page-title">Cada paciente llega, asiste y vuelve</h1>
      </div>
      <div class="sh-side sh-in">
        <p class="bringer-large-text">Un chatbot solo responde mensajes. Este sistema acompaña a tu paciente desde el anuncio hasta su regreso.</p>
        <div class="sh-actions">
          <a href="#demo-atencion" class="bringer-button sh-primary">Probar el sistema</a>
          <a href={NEGOCIO.agenda} target="_blank" rel="noopener" class="sh-ghost">Agendar 15 minutos</a>
        </div>
      </div>
    </div>
    <div class="bringer-hero-media-wrap bringer-masked-block sh-media-wrap">
      <!-- La entrada del hero es solo CSS: no espera al JavaScript del theme, que en móvil retrasaba la imagen principal unos 3 s. -->
      <div class="bringer-hero-media bringer-masked-media sh-media">
        <img src="/img/ia/hero-sistema.webp" srcset="/img/ia/hero-sistema-800.webp 800w, /img/ia/hero-sistema.webp 1536w" sizes="(max-width: 860px) 460px, 100vw" alt="" width="1536" height="1024" fetchpriority="high" />
        <div class="sh-tint" aria-hidden="true"></div>
        <div class="sh-scene" role="img" aria-label="Ejemplo de la aplicación del sistema en un teléfono, con avisos de una nueva consulta, una cita confirmada y un espacio recuperado.">
          <div class="sh-device"><div class="sh-phone" aria-hidden="true">
            <div class="sh-island"></div>
            <div class="sh-screen">
              <div class="sh-app-top"><span>Recepción</span><i>Ejemplo</i></div>
              <p class="sh-kicker">Citas de hoy</p>
              <p class="sh-big">18</p>
              <div class="sh-seg"><b></b><b></b><b></b><b></b><b></b><u></u><u></u></div>
              <div class="sh-card sh-rose"><small>Confirmadas</small><strong>14</strong></div>
              <div class="sh-row"><span>Por confirmar</span><strong>3</strong></div>
              <div class="sh-row"><span>Lista de espera</span><strong>2</strong></div>
              <div class="sh-row"><span>Para atender primero</span><strong>1</strong></div>
              <div class="sh-tab"><b></b><u></u><u></u><u></u></div>
            </div>
          </div>
          {avisos.map(aviso => <div class:list={['sh-aviso', aviso.clase]} aria-hidden="true"><span class="sh-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={aviso.icono}></svg></span><div><strong>{aviso.titulo}</strong><small>{aviso.texto}</small></div></div>)}
          </div>
        </div>
      </div>
      <div class="bringer-masked-content at-bottom-right" data-appear="zoom-out" data-delay="300" data-threshold="0">
        <a href="#recorrido-sistema" class="bringer-square-button" aria-label="Ver cómo funciona el sistema"><span class="bringer-icon bringer-icon-explore"></span></a>
      </div>
    </div>
  </div>
</section>
<style is:global>
  /* El theme oculta la página hasta que carga main.js, el último de sus scripts diferidos. Aquí se muestra de inmediato; la salida al navegar (.is-loading) se conserva. */
  body:not(.is-loaded):not(.is-loading) main#bringer-main:has(#sistema-hero){opacity:1}
  /* st-core.js define la altura del header después; sin este respaldo el contenido saltaría unos 70 px. */
  main#bringer-main:has(#sistema-hero){padding-top:var(--st-header-height,70px)}
  body:has(#sistema-hero) #bringer-header:not(.is-unloading){opacity:1;transform:none}
  .sh .sh-top{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:clamp(24px,5vw,72px);align-items:end;margin-bottom:clamp(28px,4vw,48px)}.sh .sh-top h1{margin:12px 0 0;max-width:13ch}.sh .sh-side p{margin:0 0 20px}
  .sh .sh-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px}.sh .sh-primary{min-height:48px}.sh .sh-ghost{color:var(--bringer-s-heading);font-size:15px;text-decoration:underline;text-underline-offset:.25em}
  .sh .sh-media-wrap{position:relative}.sh .sh-media{position:relative;width:100%!important;max-width:100%;height:clamp(500px,60vw,720px);overflow:hidden;border-radius:var(--bringer-large-br);background:var(--bringer-s-body-bg)}.sh .sh-media>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:0 40%}
  .sh .sh-tint{position:absolute;inset:0;background:linear-gradient(180deg,#07090D00 0%,#07090D33 55%,#07090DCC 100%)}
  .sh .sh-scene{position:absolute;inset:0;display:flex;justify-content:flex-end;align-items:flex-start;padding:clamp(40px,6vw,72px) clamp(110px,16vw,240px) 0 0}.sh .sh-device{position:relative;flex:none}
  .sh .sh-phone{position:relative;width:clamp(250px,25vw,330px);aspect-ratio:9/18.6;padding:9px;border-radius:44px;background:#07090D;box-shadow:0 0 0 1px #F5F7FA27,0 40px 80px #0009;animation:sh-sube .3s cubic-bezier(.16,1,.3,1) .1s both}
  .sh .sh-island{position:absolute;top:18px;left:50%;width:30%;height:18px;margin-left:-15%;border-radius:12px;background:#000;z-index:1}
  .sh .sh-screen{height:100%;padding:46px 18px 16px;box-sizing:border-box;border-radius:36px;background:#F5F7FA;color:#07090D;overflow:hidden}
  .sh .sh-app-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;font-size:13px;font-weight:600}.sh .sh-app-top i{font-style:normal;font-size:11px;font-weight:400;color:#2A2D35}
  .sh .sh-kicker{margin:0;font-size:12px;line-height:1.4;color:#2A2D35}.sh .sh-big{margin:0 0 10px;font-size:clamp(52px,5.4vw,72px);font-weight:600;line-height:1;letter-spacing:-.05em;color:#07090D}
  .sh .sh-seg{display:flex;gap:3px;margin-bottom:14px}.sh .sh-seg>*{flex:1;height:8px;border-radius:3px;background:var(--ea-gradiente-diagonal)}.sh .sh-seg u{background:#07090D1f}
  .sh .sh-card{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;padding:14px;border-radius:var(--bringer-small-br);background:#07090D}.sh .sh-card small{font-size:12px;color:#FFFFFFC0}.sh .sh-card strong{font-size:26px;font-weight:600;line-height:1;color:#fff}
  .sh .sh-row{display:flex;justify-content:space-between;padding:9px 2px;border-bottom:1px solid #07090D27;font-size:12px;color:#2A2D35}.sh .sh-row strong{font-weight:600;color:#07090D}
  .sh .sh-tab{display:flex;justify-content:center;gap:8px;margin-top:16px}.sh .sh-tab>*{width:26px;height:26px;border-radius:50%;background:#07090D14}.sh .sh-tab b{background:#07090D}
  .sh .sh-aviso{position:absolute;display:flex;align-items:center;gap:10px;max-width:270px;padding:10px 14px 10px 10px;border:1px solid #F5F7FA27;border-radius:var(--bringer-small-br);background:#1A1D24;color:#F5F7FA;box-shadow:0 16px 40px #0007;animation:sh-aviso .3s cubic-bezier(.16,1,.3,1) both}.sh .sh-aviso strong{display:block;font-size:13px;font-weight:600;line-height:1.3;color:#F5F7FA}.sh .sh-aviso small{display:block;font-size:12px;line-height:1.35;color:#C5C7CE}.sh .sh-mark{display:grid;place-items:center;flex:none;width:32px;height:32px;box-sizing:border-box;border:1px solid #F5F7FA;border-radius:9px;background:transparent;color:#F5F7FA}.sh .sh-mark svg{position:static;display:block;width:18px;height:18px;opacity:1!important;transform:none}
  .sh .sh-aviso{width:max-content}.sh .sh-aviso.is-a{top:11%;right:calc(100% - 12px);animation-delay:.45s}.sh .sh-aviso.is-b{top:33%;left:calc(100% - 12px);animation-delay:.7s}.sh .sh-aviso.is-c{top:80%;right:calc(100% - 26px);animation-delay:.95s}
  .sh .sh-in{animation:sh-texto .3s cubic-bezier(.16,1,.3,1) both}.sh .sh-side.sh-in{animation-delay:.1s}
  @keyframes sh-texto{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@keyframes sh-sube{from{opacity:0;transform:translateY(48px)}to{opacity:1;transform:none}}@keyframes sh-aviso{from{opacity:0;transform:translateY(12px) scale(.97)}to{opacity:1;transform:none}}
  @media(max-width:860px){.sh .sh-top{grid-template-columns:minmax(0,1fr);gap:20px}.sh .sh-top h1{max-width:none}.sh .sh-media{height:640px}.sh .sh-scene{justify-content:center;padding:230px 0 0}.sh .sh-phone{width:262px}.sh .sh-aviso{max-width:220px;padding:8px 12px 8px 8px}.sh .sh-aviso.is-a{top:58%;right:auto;left:-36px}.sh .sh-aviso.is-b{top:68%;left:auto;right:-36px}.sh .sh-aviso.is-c{top:78%;right:auto;left:-28px}.sh .bringer-masked-content{display:none}.sh .sh-media{height:720px}.sh .sh-media>img{height:300px;object-position:12% 34%}.sh .sh-tint{background:linear-gradient(180deg,#07090D00 0%,#07090D00 26%,#07090D 44%)}}
  @media(prefers-reduced-motion:reduce){.sh .sh-phone,.sh .sh-aviso,.sh .sh-in{animation:none}}
</style>
