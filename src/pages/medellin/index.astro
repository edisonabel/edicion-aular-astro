---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/geo/JsonLd.astro';
import Breadcrumbs from '../../components/geo/Breadcrumbs.astro';
import FaqList from '../../components/geo/FaqList.astro';
import Cta from '../../components/geo/Cta.astro';
import { ZONAS } from '../../data/ia/zonas';
import { SOLUCIONES } from '../../data/ia/soluciones';
import { NEGOCIO } from '../../data/ia/negocio';
import { breadcrumbs, localBusiness, faqPage, webPage } from '../../lib/schema';

const pageTitle = "Soluciones con IA en Medellín y Valle de Aburrá | Edición Aular";
const pageDesc = "Implementación local de soluciones de Inteligencia Artificial para empresas y pymes en Medellín, Envigado, Itagüí, Sabaneta y Bello. Agentes, automatización y SEO local.";
const pageUrl = "/medellin";

const faqsMedellin = [
  {
    q: "¿Por qué es importante contratar una agencia con presencia en Medellín para implementar IA?",
    a: "Comprender los canales preferidos de los consumidores locales (más del 90% de interacciones comerciales en Medellín suceden por WhatsApp), los horarios de atención y la normativa colombiana de protección de datos (Ley 1581) y contactos comerciales (Ley 2300 de 2023) es indispensable para que las soluciones de IA conviertan sin fricciones legales ni operativas."
  },
  {
    q: "¿Hacen visitas presenciales a empresas en el Valle de Aburrá?",
    a: "Sí. Para diagnósticos estratégicos y capacitaciones de equipos de trabajo atendemos presencialmente en El Poblado, Laureles, Centro, Envigado, Itagüí, Sabaneta, Bello y demás zonas del área metropolitana."
  },
  {
    q: "¿Qué tipo de empresas en Medellín están aprovechando más la IA?",
    a: "Clínicas estéticas y odontológicas (agenda 24/7), hoteles y alojamientos turísticos (atención bilingüe a extranjeros), inmobiliarias (calificación de prospectos) y distribuidores mayoristas del Centro e Itagüí (pedidos y catálogos automáticos)."
  }
];

const schemaData = [
  webPage({ name: pageTitle, description: pageDesc, path: pageUrl }),
  localBusiness(ZONAS.map((z) => `${z.nombre}, ${z.municipio}`)),
  breadcrumbs([
    { name: "Inicio", href: "/" },
    { name: "Medellín y Valle de Aburrá", href: pageUrl }
  ]),
  faqPage(faqsMedellin)
];
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <JsonLd slot="head" data={schemaData} />

  <div class="stg-container">
    <Breadcrumbs items={[
      { name: "Inicio", href: "/" },
      { name: "Medellín y Valle de Aburrá" }
    ]} />

    <!-- Hero -->
    <section class="stg-top-gap-m">
      <div class="stg-row stg-large-gap stg-valign-middle">
        <div class="stg-col-8">
          <span class="bringer-label">Presencia Local · Medellín & Área Metropolitana</span>
          <h1 class="bringer-page-title stg-top-gap-s">
            Soluciones de IA para empresas del Valle de Aburrá<span class="bringer-accent">.</span>
          </h1>

          <div class="geo-answer-card">
            <p>
              En Edición Aular ayudamos a marcas y pymes de Medellín a modernizar sus procesos comerciales con Inteligencia Artificial: desde agentes de WhatsApp conectados a Meta API oficial hasta automatización administrativa y posicionamiento en motores generativos (ChatGPT, Gemini y Perplexity).
            </p>
          </div>
        </div>

        <div class="stg-col-4">
          <div class="bringer-block is-accented">
            <span class="bringer-label">Atención Local</span>
            <h4>Sede y Cobertura</h4>
            <p style="font-size: 0.95rem;">
              Base en Medellín con servicio presencial y virtual en toda Antioquia y Colombia.
            </p>
            <a href={NEGOCIO.googleMaps} target="_blank" rel="noopener" class="bringer-arrow-link stg-top-gap-s">
              Ver ficha de Google Business
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Directorio de Zonas Comerciales -->
    <section class="geo-section">
      <div class="stg-row stg-bottom-gap">
        <div class="stg-col-8">
          <h2>Zonas y municipios con atención especializada</h2>
          <p class="bringer-large-text">
            Explora las necesidades operativas y casos de uso de IA según la dinámica de cada sector:
          </p>
        </div>
      </div>

      <div class="bringer-grid-2cols stg-normal-gap">
        {ZONAS.map((z) => (
          <div class="bringer-block stg-vertical-space-between">
            <div>
              <span class="bringer-label">{z.tipo.toUpperCase()} · {z.municipio}</span>
              <h3 class="stg-top-gap-s">
                <a href={`/medellin/${z.slug}`} style="color: inherit; text-decoration: none;">
                  {z.nombre}
                </a>
              </h3>
              <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6;">
                {z.intro}
              </p>

              <div style="margin-top: 1rem;">
                <strong style="font-size: 0.85rem; color: #94a3b8; text-transform: uppercase;">Ejes principales:</strong>
                <p style="font-size: 0.9rem; color: #cbd5e1; margin-top: 0.25rem;">
                  {z.ejes.join(" · ")}
                </p>
              </div>
            </div>

            <div class="stg-top-gap-m" style="display: flex; justify-content: space-between; align-items: center;">
              <a href={`/medellin/${z.slug}`} class="bringer-arrow-link">
                Ver servicios en {z.nombre}
              </a>
              {z.wikipedia && (
                <a href={z.wikipedia} target="_blank" rel="noopener" class="geo-small" style="color: #64748b;">
                  Referencia geográfica ↗
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Soluciones Transversales Disponibles -->
    <section class="geo-section">
      <h2>Soluciones aplicables en tu zona</h2>
      <div class="bringer-grid-3cols stg-top-gap-s">
        {SOLUCIONES.map((sol) => (
          <div class="bringer-block">
            <h5>
              <a href={`/soluciones-ia/${sol.slug}`} style="color: inherit; text-decoration: none;">
                {sol.nombre}
              </a>
            </h5>
            <p style="font-size: 0.9rem; color: #94a3b8; margin: 0.5rem 0;">{sol.respuesta.substring(0, 110)}...</p>
            <a href={`/soluciones-ia/${sol.slug}`} class="bringer-arrow-link" style="font-size: 0.85rem;">
              Conocer solución
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQs de Medellín -->
    <FaqList faqs={faqsMedellin} titulo="Preguntas frecuentes sobre servicios de IA en Medellín" />

    <!-- CTA -->
    <Cta 
      titulo="¿Tu negocio está ubicado en Medellín o el Valle de Aburrá?"
      texto="Agenda una llamada o visita de diagnóstico. Analizamos cómo implementar IA en tus canales de venta y atención."
    />
  </div>
</BaseLayout>
