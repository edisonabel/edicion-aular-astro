---
import { DEMO_DEFAULT, DEMO_ESPECIALIDADES, DEMO_ETAPAS, DEMO_SECTORS, getDemoSector } from '../lib/demo-atencion.js';
const { sector = DEMO_DEFAULT, titulo = 'Vive el recorrido completo', fijarSector = false } = Astro.props;
const inicial = getDemoSector(sector) ?? getDemoSector(DEMO_DEFAULT);
const otros = DEMO_SECTORS.filter(item => !item.salud);
---
<section id="demo-atencion" class="demo" data-demo data-sector={inicial.id} data-fijar={fijarSector ? 'true' : undefined} data-template="propio#demo-atencion" aria-labelledby="demo-heading">
  <header class="demo-intro">
    <span class="bringer-label" data-appear="fade-up">Demo simulada · funciona con reglas, sin IA en vivo</span>
    <h2 id="demo-heading" data-appear="fade-up">{titulo}<span class="bringer-accent">.</span></h2>
    <p data-appear="fade-up" data-delay="100">Escribe como un paciente y mira lo que recibe tu equipo. Nada se guarda ni se envía.</p>
  </header>
  <div class="demo-tabs" role="tablist" aria-label="Vista de la demo" data-demo-tabs>
    <button type="button" role="tab" aria-selected="true" aria-controls="demo-telefono" id="demo-tab-paciente" data-demo-tab="paciente">Paciente</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="demo-recepcion-panel" id="demo-tab-recepcion" data-demo-tab="recepcion">Recepción<i data-demo-aviso hidden></i></button>
  </div>
  <div class="demo-stage" data-demo-stage data-vista="paciente">
    <div class="demo-phone" id="demo-telefono" data-appear="fade-up">
      <div class="demo-island" aria-hidden="true"></div>
      <div class="demo-screen">
        <div class="demo-welcome" data-demo-welcome>
          <p class="demo-kicker">Empieza aquí</p>
          <h3>¿Qué negocio quieres probar?</h3>
          <label class="demo-name"><span>Nombre de tu negocio (opcional)</span>
            <input type="text" maxlength="40" autocomplete="organization" placeholder="Clínica Vital" data-demo-negocio />
          </label>
          <p class="demo-group">Salud y estética</p>
          <div class="demo-list">{DEMO_ESPECIALIDADES.map(item=><button type="button" data-demo-elegir={inicial.salud||!fijarSector?'clinicas-estetica':inicial.id} data-demo-especialidad={item.id}>{item.label}<span aria-hidden="true">→</span></button>)}</div>
          <p class="demo-group">Otros negocios</p>
          <div class="demo-list">{otros.map(item=><button type="button" data-demo-elegir={item.id}>{item.label}<span aria-hidden="true">→</span></button>)}</div>
        </div>
        <div class="demo-app" data-demo-app hidden>
          <div class="demo-top">
            <button type="button" class="demo-back" aria-label="Elegir otro negocio" data-demo-volver hidden={fijarSector}>←</button>
            <span class="demo-avatar" aria-hidden="true" data-demo-inicial>C</span>
            <div><strong data-demo-name>{inicial.label}</strong><small>Asistente · ejemplo</small></div>
          </div>
          <div class="demo-log" role="log" aria-live="polite" tabindex="0" aria-label="Conversación de la demo" data-demo-log></div>
          <div class="demo-options" data-demo-options></div>
          <form class="demo-composer" data-demo-form>
            <label class="demo-sr" for="demo-texto">Escribe tu mensaje</label>
            <input id="demo-texto" type="text" maxlength="160" autocomplete="off" placeholder="¿Cuánto cuesta?" data-demo-texto />
            <button type="submit" aria-label="Enviar mensaje"><span aria-hidden="true">↑</span></button>
          </form>
        </div>
      </div>
    </div>
    <aside class="demo-panel" id="demo-recepcion-panel" aria-label="Lo que ve recepción" data-appear="fade-up" data-delay="100">
      <div class="demo-panel-top"><span>Recepción</span><span>Ejemplo</span></div>
      <h3><span data-demo-persona>Tu recepción</span><em data-demo-etapa-label>Esperando la primera consulta</em></h3>
      <ol class="demo-seg" aria-hidden="true">{DEMO_ETAPAS.map(etapa=><li data-demo-etapa={etapa}></li>)}</ol>
      <div class="demo-prio" data-demo-prio><small>Prioridad sugerida</small><strong data-demo-prio-valor>Pendiente</strong></div>
      <dl class="demo-rows" data-demo-rows></dl>
      <p class="demo-subtitle">Lo que hizo el sistema</p>
      <ol class="demo-events" data-demo-eventos><li class="is-empty">Aparecerá aquí cuando empiece la conversación.</li></ol>
      <button type="button" class="demo-cta" data-demo-whatsapp data-contact-channel="whatsapp">Quiero este sistema <span aria-hidden="true">↗</span></button>
      <p class="demo-help">El mensaje queda preparado. Tú decides cuándo enviarlo.</p>
    </aside>
  </div>
  <noscript><p>Puedes <a href="https://wa.me/573002730128">escribirnos por WhatsApp</a> o <a href="https://cal.com/edicion-aular-website">agendar una conversación</a>.</p></noscript>
</section>
<script>
  import { DEMO_DEFAULT, DEMO_ESPECIALIDADES, DEMO_ETAPAS, DEMO_RECORRIDO, demoEtapa, demoIniciar, demoResponder, demoWhatsapp, getDemoEspecialidad, getDemoSector, limpiarNegocio } from '../lib/demo-atencion.js';
  const root=document.querySelector<HTMLElement>('[data-demo]');
  if(root){
    const q=<T extends Element>(selector:string)=>root.querySelector<T>(selector)!;
    const log=q<HTMLElement>('[data-demo-log]'),options=q<HTMLElement>('[data-demo-options]'),rows=q<HTMLElement>('[data-demo-rows]'),eventos=q<HTMLElement>('[data-demo-eventos]'),stage=q<HTMLElement>('[data-demo-stage]');
    const welcome=q<HTMLElement>('[data-demo-welcome]'),app=q<HTMLElement>('[data-demo-app]'),form=q<HTMLFormElement>('[data-demo-form]'),texto=q<HTMLInputElement>('[data-demo-texto]'),negocio=q<HTMLInputElement>('[data-demo-negocio]'),aviso=q<HTMLElement>('[data-demo-aviso]');
    const pausa=matchMedia('(prefers-reduced-motion: reduce)').matches?0:650,fijo=root.dataset.fijar==='true';
    let sectorId=root.dataset.sector||DEMO_DEFAULT,especialidadId=DEMO_ESPECIALIDADES[0].id,actual:any=null,turno=0,ocupado=false,hayInteraccion=false,fase='chat',recorrido=0,extras:Record<string,string>={},eventosExtra:string[]=[];
    // Un enlace puede preparar la demo para un prospecto: ?negocio=Clínica%20Vital&especialidad=estetica
    const pedido=new URLSearchParams(location.search);
    const especialidadPedida=getDemoEspecialidad(pedido.get('especialidad')||''),sectorPedido=!fijo&&getDemoSector(pedido.get('sector')||'');
    if(especialidadPedida)especialidadId=especialidadPedida.id;
    if(sectorPedido)sectorId=sectorPedido.id;
    negocio.value=limpiarNegocio(pedido.get('negocio'));
    const hora=()=>new Date().toLocaleTimeString('es-CO',{hour:'numeric',minute:'2-digit'});
    function mensaje(contenido:string,clase:string){
      const p=document.createElement('div');p.className=`demo-msg ${clase}`;
      const cuerpo=document.createElement('span');cuerpo.textContent=contenido;
      const meta=document.createElement('small');meta.textContent=clase==='is-user'?`${hora()} ✓✓`:hora();
      p.append(cuerpo,meta);log.append(p);log.scrollTop=log.scrollHeight;
    }
    function separador(contenido:string){const p=document.createElement('p');p.className='demo-dia';p.textContent=contenido;log.append(p);log.scrollTop=log.scrollHeight;}
    function marcarEtapas(cuantas:number){
      root!.querySelectorAll<HTMLElement>('[data-demo-etapa]').forEach((item,index)=>item.classList.toggle('is-done',index<cuantas));
      q('[data-demo-etapa-label]').textContent=`Etapa ${cuantas} de ${DEMO_ETAPAS.length} · ${DEMO_ETAPAS[cuantas-1]}`;
    }
    function avisar(){if(stage.dataset.vista==='paciente')aviso.hidden=false;}
    function pintarPaneles(){
      const {state,pasos}=actual,sector=getDemoSector(state.sectorId)!,filas:[string,string][]=[['Origen','Anuncio de ejemplo']];
      pasos.forEach((key:string,index:number)=>filas.push([key,state.ficha[key]??(state.fin?'No hace falta':index===state.paso?'Esperando…':'—')]));
      Object.entries(extras).forEach(([key,value])=>filas.push([key,value]));
      rows.replaceChildren(...filas.flatMap(([key,value])=>{const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=key;dd.textContent=value;return [dt,dd];}));
      q('[data-demo-persona]').textContent=state.motivo||state.ficha.Motivo||`Nuevo ${sector.persona}`;
      q('[data-demo-prio-valor]').textContent=state.prioridad||'Pendiente';
      const caja=q<HTMLElement>('[data-demo-prio]');caja.classList.toggle('is-active',Boolean(state.prioridad));caja.classList.toggle('is-urgent',state.prioridad.startsWith('Urgente'));
      const lista=[...state.eventos,...eventosExtra].slice(-5);
      eventos.replaceChildren(...(lista.length?lista:['Aparecerá aquí cuando empiece la conversación.']).map((item:string)=>{const li=document.createElement('li');li.textContent=item;if(!lista.length)li.className='is-empty';return li;}));
      root!.dataset.actualSector=state.sectorId;root!.dataset.actualEspecialidad=state.especialidadId;root!.dataset.actualNegocio=state.negocio;
      if(state.eventos.length||eventosExtra.length)avisar();
    }
    function botones(lista:string[],accion:(valor:string)=>void){
      options.replaceChildren(...lista.map(valor=>{const b=document.createElement('button');b.type='button';b.textContent=valor;b.addEventListener('click',()=>{hayInteraccion=true;accion(valor);});return b;}));
      log.scrollTop=log.scrollHeight;
      if(hayInteraccion&&document.activeElement!==texto)options.querySelector('button')?.focus({preventScroll:true});
    }
    function escribir(respuestas:string[],despues:()=>void){
      const este=turno;ocupado=true;options.replaceChildren();
      const siguiente=(index:number)=>{
        if(este!==turno)return;
        if(index>=respuestas.length){ocupado=false;despues();return;}
        const p=document.createElement('div');p.className='demo-msg is-bot is-typing';p.setAttribute('aria-label','Escribiendo');p.innerHTML='<i></i><i></i><i></i>';log.append(p);log.scrollTop=log.scrollHeight;
        setTimeout(()=>{if(este!==turno)return;p.remove();mensaje(respuestas[index],'is-bot');siguiente(index+1);},pausa);
      };
      siguiente(0);
    }
    function ofrecer(){
      pintarPaneles();
      if(!actual.state.fin){botones(actual.quick,responderTexto);return;}
      fase='recorrido';recorrido=0;
      botones(['Ver qué pasa después','Empezar de nuevo'],valor=>valor==='Empezar de nuevo'?iniciar():avanzarRecorrido());
    }
    function responderTexto(valor:string){
      mensaje(valor,'is-user');actual=demoResponder(actual.state,valor);pintarPaneles();
      if(actual.state.cita)marcarEtapas(3);
      escribir(actual.replies,ofrecer);
    }
    function avanzarRecorrido(){
      if(recorrido>=DEMO_RECORRIDO.length){
        fase='fin';marcarEtapas(DEMO_ETAPAS.length);eventosExtra.push('Sumó este recorrido al reporte mensual');pintarPaneles();
        separador('Reporte para tu equipo');
        escribir(['Cada mes ves cuántas consultas llegaron, por qué canal, cuántas agendaron, asistieron y volvieron.'],()=>botones(['Empezar de nuevo'],()=>iniciar()));
        return;
      }
      const etapa=demoEtapa(DEMO_RECORRIDO[recorrido],actual.state);
      marcarEtapas(DEMO_ETAPAS.indexOf(etapa.etapa)+1);separador(etapa.dia);
      escribir([etapa.text],()=>botones(Object.keys(etapa.opciones),valor=>{
        const opcion=etapa.opciones[valor];
        mensaje(valor,'is-user');extras[etapa.campo]=opcion.ficha;eventosExtra.push(...opcion.eventos);pintarPaneles();recorrido++;
        escribir([opcion.reply],()=>botones([recorrido>=DEMO_RECORRIDO.length?'Ver el reporte':'Seguir el recorrido'],()=>avanzarRecorrido()));
      }));
    }
    function iniciar(){
      turno++;ocupado=false;fase='chat';recorrido=0;extras={};eventosExtra=[];log.replaceChildren();options.replaceChildren();aviso.hidden=true;
      welcome.hidden=true;app.hidden=false;
      actual=demoIniciar({sectorId,especialidadId,negocio:negocio.value});
      const sector=getDemoSector(sectorId)!,nombre=limpiarNegocio(negocio.value)||(sector.salud?getDemoEspecialidad(especialidadId)!.label:sector.label);
      q('[data-demo-name]').textContent=nombre;q('[data-demo-inicial]').textContent=nombre[0].toUpperCase();
      marcarEtapas(2);pintarPaneles();
      escribir(actual.replies,ofrecer);
    }
    function vista(nombre:string){
      stage.dataset.vista=nombre;
      root!.querySelectorAll<HTMLElement>('[data-demo-tab]').forEach(tab=>tab.setAttribute('aria-selected',String(tab.dataset.demoTab===nombre)));
      if(nombre==='recepcion')aviso.hidden=true;
    }
    root.querySelectorAll<HTMLElement>('[data-demo-tab]').forEach(tab=>tab.addEventListener('click',()=>vista(tab.dataset.demoTab!)));
    root.querySelectorAll<HTMLElement>('[data-demo-elegir]').forEach(boton=>boton.addEventListener('click',()=>{
      hayInteraccion=true;sectorId=boton.dataset.demoElegir!;if(boton.dataset.demoEspecialidad)especialidadId=boton.dataset.demoEspecialidad;iniciar();
    }));
    q('[data-demo-volver]').addEventListener('click',()=>{turno++;app.hidden=true;welcome.hidden=false;welcome.scrollTop=0;welcome.querySelector('button')?.focus({preventScroll:true});});
    form.addEventListener('submit',event=>{
      event.preventDefault();const valor=texto.value.trim();if(!valor||ocupado)return;texto.value='';hayInteraccion=true;
      if(fase==='chat'){responderTexto(valor);return;}
      const previas=Array.from(options.querySelectorAll('button')).map(boton=>boton.textContent||'');
      mensaje(valor,'is-user');escribir(['En esta parte de la demo elige una opción. En un proyecto, el asistente también entiende mensajes escritos.'],()=>{
        if(fase==='fin')botones(['Empezar de nuevo'],()=>iniciar());
        else if(recorrido===0)botones(['Ver qué pasa después','Empezar de nuevo'],v=>v==='Empezar de nuevo'?iniciar():avanzarRecorrido());
        else botones(previas.length?previas:['Seguir el recorrido'],()=>avanzarRecorrido());
      });
    });
    // Como en el orientador: el botón no expone la URL con respuestas a la medición automática de enlaces.
    q('[data-demo-whatsapp]').addEventListener('click',()=>{
      window.location.assign(demoWhatsapp({sectorId,especialidadId,negocio:negocio.value}).whatsapp);
    });
    // Sin contexto previo, primero se elige el negocio. Con enlace personalizado o página de sector, se entra directo.
    if(fijo||especialidadPedida||sectorPedido||negocio.value)iniciar();
  }
</script>
<style is:global>
  .demo{padding:clamp(64px,9vw,120px) 0;scroll-margin-top:72px}.demo [hidden]{display:none!important}
  .demo-intro{max-width:640px;margin-bottom:clamp(28px,4vw,48px)}.demo-intro h2{margin:12px 0}.demo-intro p{margin:0;font-size:clamp(16px,1.4vw,19px);line-height:1.55}
  .demo-tabs{display:none}
  .demo-stage{display:grid;grid-template-columns:minmax(0,400px) minmax(0,1fr);gap:clamp(24px,4vw,56px);align-items:stretch}
  .demo-phone{position:relative;box-sizing:border-box;width:100%;max-width:400px;height:780px;padding:10px;border-radius:52px;background:var(--bringer-s-body-bg);box-shadow:0 0 0 1px var(--bringer-s-border),0 30px 80px color-mix(in srgb,var(--bringer-s-accent) 15%,transparent),0 30px 60px #0006}
  .demo-island{position:absolute;top:20px;left:50%;width:96px;height:24px;margin-left:-48px;border-radius:14px;background:#000;z-index:2}
  .demo-screen{position:relative;height:100%;box-sizing:border-box;border-radius:42px;background:var(--bringer-s-container-bg);color:var(--bringer-s-heading);overflow:hidden}
  
  .demo-welcome{height:100%;box-sizing:border-box;padding:60px 20px 20px;overflow-y:auto;overscroll-behavior:contain;animation:demo-entra .3s cubic-bezier(.16,1,.3,1)}.demo-kicker{margin:0;font-size:12px;color:var(--bringer-s-text)}.demo-welcome h3{margin:4px 0 14px;font-size:26px;font-weight:600;line-height:1.12;letter-spacing:-.035em;color:inherit}
  .demo-name{display:block;margin:0 0 12px;font-size:13px;font-weight:400;letter-spacing:normal;text-transform:none;color:var(--bringer-s-text)}.demo-name span{display:block;margin-bottom:6px}
  .demo .demo-name input,.demo .demo-composer input{width:100%;min-height:46px;margin:0;padding:10px 14px;box-sizing:border-box;border:1px solid var(--bringer-s-border);border-radius:var(--bringer-small-br);background:var(--bringer-s-body-bg);color:inherit;font:inherit;font-size:16px;line-height:1.3;letter-spacing:normal;text-transform:none;box-shadow:none}.demo input::placeholder{color:var(--bringer-s-text);opacity:.8}
  
  .demo-group{margin:12px 0 2px;font-size:12px;font-weight:600;color:var(--bringer-s-text)}
  .demo .demo-list{display:flex;flex-direction:column}.demo .demo-list button{display:flex;justify-content:space-between;align-items:center;width:100%;min-height:45px;margin:0;padding:0 2px;border:0;border-bottom:1px solid var(--bringer-s-border);border-radius:0;background:transparent;color:inherit;font:inherit;font-size:16px;font-weight:400;letter-spacing:0;text-transform:none;text-align:left;cursor:pointer;transition:padding .15s,color .15s}.demo .demo-list button span{color:var(--bringer-s-text-accent);transition:transform .15s}.demo .demo-list button:hover{color:var(--bringer-s-text-accent);background:transparent}.demo .demo-list button:hover span{transform:translateX(4px)}
  
  .demo-app{display:flex;flex-direction:column;height:100%;animation:demo-entra .3s cubic-bezier(.16,1,.3,1)}
  .demo-top{display:flex;align-items:center;gap:10px;padding:54px 14px 12px;border-bottom:1px solid var(--bringer-s-border)}.demo-top strong{display:block;font-size:15px;font-weight:600;line-height:1.25;color:inherit}.demo-top small{display:block;font-size:12px;line-height:1.3;color:var(--bringer-s-text)}
  .demo .demo-back{display:grid;place-items:center;flex:none;width:36px;height:44px;min-height:44px;margin:0;padding:0;border:0;background:transparent;color:inherit;font-size:20px;line-height:1;cursor:pointer}.demo .demo-back:hover{background:transparent;color:var(--bringer-s-text-accent)}
  .demo-avatar{display:grid;place-items:center;flex:none;width:38px;height:38px;border-radius:13px;background:var(--bringer-s-accent);color:#fff;font-size:16px;font-weight:600}
  .demo-log{display:flex;flex:1 1 auto;flex-direction:column;gap:8px;min-height:0;padding:14px;overflow-y:auto;overscroll-behavior:contain}.demo-log:focus-visible{outline:2px solid var(--bringer-s-text-accent);outline-offset:-4px}
  .demo-msg{display:flex;flex-direction:column;gap:2px;max-width:84%;padding:9px 13px;border-radius:18px;font-size:15px;line-height:1.4;animation:demo-msg .2s cubic-bezier(.16,1,.3,1)}.demo-msg small{align-self:flex-end;font-size:10px;line-height:1.2;opacity:.65}.demo-msg.is-bot{align-self:flex-start;border-bottom-left-radius:6px;background:var(--bringer-s-body-bg);color:inherit}.demo-msg.is-user{align-self:flex-end;border-bottom-right-radius:6px;background:var(--bringer-s-accent);color:#fff}
  .demo-msg.is-typing{flex-direction:row;gap:4px;padding:14px}.demo-msg.is-typing i{width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.4;animation:demo-punto 1s infinite}.demo-msg.is-typing i:nth-child(2){animation-delay:.15s}.demo-msg.is-typing i:nth-child(3){animation-delay:.3s}
  .demo-dia{align-self:center;margin:8px 0 2px;font-size:12px;font-weight:600;line-height:1.4;color:var(--bringer-s-text-accent)}
  .demo .demo-options{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:6px;padding:0 14px 8px}.demo .demo-options:empty{display:none}.demo .demo-options button{min-height:40px;margin:0;padding:8px 13px;border:1px solid var(--bringer-s-text-accent);border-radius:14px;background:transparent;color:inherit;font:inherit;font-size:14px;font-weight:400;line-height:1.2;letter-spacing:0;text-transform:none;text-align:left;white-space:normal;cursor:pointer;animation:demo-msg .2s cubic-bezier(.16,1,.3,1);transition:background .15s}.demo .demo-options button:hover{background:color-mix(in srgb,var(--bringer-s-accent) 18%,transparent);color:inherit}
  .demo-composer{display:grid;grid-template-columns:minmax(0,1fr) 46px;gap:8px;padding:6px 14px 22px}.demo .demo-composer button{display:grid;place-items:center;width:46px;height:46px;min-height:46px;margin:0;padding:0;border:0;border-radius:50%;background:var(--bringer-s-accent);color:#fff;font-size:20px;line-height:1;cursor:pointer}.demo .demo-composer button:hover{background:var(--bringer-button-hover-bg);color:#fff}
  .demo-panel{display:flex;flex-direction:column;min-width:0;box-sizing:border-box;padding:clamp(20px,3vw,36px);border-radius:var(--bringer-large-br);background:#F5F7FA;color:#07090D}
  .demo-panel-top{display:flex;justify-content:space-between;margin-bottom:clamp(18px,3vw,32px);font-size:13px;color:#2A2D35}.demo-panel-top span:first-child{font-weight:600;color:#07090D}
