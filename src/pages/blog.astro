---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import JsonLd from '../components/geo/JsonLd.astro';
import blogData from '../data/blog.json';
import { normalizeSearch } from '../lib/blog';
import { ORG_ID } from '../lib/schema';
import '../styles/blog-brand.css';
const posts = [...blogData].sort((a, b) => b.date.localeCompare(a.date));
const categories = [...new Set(posts.map(p => p.category))];
const featured = posts.filter(p => p.featured);
const archiveCount = posts.filter(p => p.id <= 19).length;
const newCount = posts.length - archiveCount;
---
<BaseLayout title="Blog de IA, diseño web y marketing | Edición Aular" description="Guías prácticas para decidir qué automatizar, mejorar tu sitio web y organizar el marketing de tu negocio. Explora el blog de Edición Aular.">
  <JsonLd slot="head" data={{ '@context': 'https://schema.org', '@type': 'Blog', name: 'Blog de Edición Aular', url: 'https://edicionaular.com/blog/', publisher: { '@id': ORG_ID }, inLanguage: 'es-CO' }} />
  <div class="stg-container blog-index">
    <section>
      <div class="bringer-hero-block bringer-hero-type02"><div class="stg-row"><div class="stg-col-8 stg-offset-2 align-center">
        <h1 class="bringer-page-title" data-split-appear="fade-up" data-split-unload="fade-up">Blog de Marketing Digital<span class="bringer-accent">.</span></h1>
        <p class="bringer-large-text" data-appear="fade-up" data-delay="100">Estrategias, tendencias y consejos prácticos para llevar tu marca al siguiente nivel.<br><span class="bringer-accent">Creatividad y tecnología para tu negocio.</span></p>
        <div class="bringer-blog-search" data-appear="fade-up" data-delay="200">
          <label class="blog-search-label" for="blogSearch">Buscar artículos</label>
          <div class="bringer-search-form"><input id="blogSearch" type="search" placeholder="Buscar artículos… (ej. funnel, webinar, IA)" aria-controls="blog-posts" /><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.35-4.35" /></svg></div>
        </div>
        <p class="blog-archive-link"><a href="#archivo-blog">Ver el archivo completo · {posts.length} artículos</a></p>
      </div></div></div>
    </section>
    {featured.length > 0 && <section id="blog-featured" class="backlight-top" aria-labelledby="featured-title">
      <div class="stg-row bringer-section-title"><div class="stg-col-8 stg-offset-2 align-center"><h2 id="featured-title" data-appear="fade-up">Artículos Destacados</h2><p class="bringer-large-text" data-appear="fade-up">Una selección de nuestro blog</p></div></div>
      <div class="bringer-grid-3cols blog-grid">{featured.map(post => <BlogCard post={post} />)}</div>
    </section>}
    <section id="archivo-blog" aria-labelledby="archive-title">
      <div class="stg-row bringer-section-title"><div class="stg-col-8 stg-offset-2 align-center"><h2 id="archive-title" data-appear="fade-up">Todos los Artículos</h2><p class="bringer-large-text" data-appear="fade-up">{archiveCount} artículos del archivo y {newCount} publicaciones nuevas sobre IA.</p></div></div>
      <div class="bringer-filter-buttons blog-filters align-center" role="group" aria-label="Filtrar por tema">
        <button type="button" class="bringer-filter-button" data-category="" aria-pressed="true">Todos</button>
        {categories.map(category => <button type="button" class="bringer-filter-button" data-category={category} aria-pressed="false">{category}</button>)}
      </div>
      <p id="blog-results" class="align-center" role="status" aria-live="polite" aria-atomic="true">{posts.length} artículos disponibles</p>
      <div id="blog-posts" class="bringer-grid-3cols blog-grid">{posts.map(post => <div data-blog-post data-category={post.category} data-search={normalizeSearch([post.title, post.excerpt, post.category, ...(post.tags || []), ...(post.searchAliases || [])].join(' '))}><BlogCard post={post} /></div>)}</div>
      <p id="blog-empty" class="align-center" hidden>Prueba con otra palabra o selecciona «Todos».</p>
    </section>
    <section class="divider-top backlight-top"><div class="stg-row"><div class="stg-col-6 stg-offset-3 align-center"><div class="bringer-block blog-rss-card" data-appear="fade-up">
      <h3>Sigue nuestras publicaciones<span class="bringer-accent">.</span></h3><p class="bringer-large-text">Recibe los nuevos artículos en tu lector RSS.</p><a href="/rss.xml" class="bringer-button blog-brand-button">Seguir el blog por RSS</a>
    </div></div></div></section>
        <!-- CTA Section -->
        <section class="divider-top">
            <div class="bringer-bento-grid bringer-grid-cta">
                <div class="is-large bringer-masked-block" data-appear="fade-left" data-unload="fade-left">
                    <div class="bringer-grid-cta-media bringer-masked-media bg-lava">
                        <div class="bringer-grid-cta-heading">¿Listo Para Transformar Tu Marca?</div>
                    </div>
                    <div class="bringer-masked-content at-bottom-right">
                        <p class="bringer-large-text" data-appear="fade-right" data-delay="100">Hablemos de tu proyecto →</p>
                    </div>
                </div>

                <div class="is-medium bringer-block" data-appear="fade-down" data-unload="fade-right">
                    <h3>Agenda una consultoría gratuita y descubre cómo podemos ayudarte.</h3>
                </div>

                <div class="is-small" data-appear="zoom-out" data-delay="100" data-unload="zoom-out">
                    <a href="https://cal.com/edicion-aular-website" class="bringer-square-button" aria-label="Agendar una conversación">
                        <span class="bringer-icon bringer-icon-explore"></span>
                    </a>
                </div>

                <div class="is-small" data-appear="zoom-out" data-delay="200" data-unload="zoom-out">
                    <img src="/img/cta/contact3.webp" alt="Diseño y creatividad" width="960" height="960" loading="lazy" decoding="async">
                </div>
            </div>
        </section>
  </div>
</BaseLayout>
<script>
  import { normalizeSearch } from '../lib/blog';
  const input = document.querySelector<HTMLInputElement>('#blogSearch');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.blog-filters button')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-blog-post]')];
  const results = document.querySelector('#blog-results');
  const featured = document.querySelector<HTMLElement>('#blog-featured');
  const empty = document.querySelector<HTMLElement>('#blog-empty');
  let category = '';
  function filterPosts() {
    const query = normalizeSearch(input?.value.trim() || '');
    let count = 0;
    for (const card of cards) {
      card.hidden = !!((category && card.dataset.category !== category) || !card.dataset.search?.includes(query));
      if (!card.hidden) count++;
    }
    if (results) results.textContent = `${count} ${count === 1 ? 'artículo disponible' : 'artículos disponibles'}${category ? ` en ${category}` : ''}`;
    if (empty) empty.hidden = count !== 0;
    if (featured) featured.hidden = !!(query || category);
  }
  input?.addEventListener('input', filterPosts);
  buttons.forEach(button => button.addEventListener('click', () => {
    category = button.dataset.category || '';
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    filterPosts();
  }));
</script>
<style>
  .blog-index [hidden] { display: none !important; }
  .bringer-blog-search { margin-top: 2rem; }
  .blog-search-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .bringer-search-form { position: relative; max-width: 800px; margin: 0 auto; }
  .bringer-search-form input { width: 100%; padding: 1rem 3.5rem 1rem 1.5rem; font: inherit; font-size: 1rem; border: 2px solid var(--bringer-s-border); border-radius: 50px; background: var(--bringer-s-container-bg); color: var(--bringer-s-heading); }
  .bringer-search-form input::placeholder { color: var(--bringer-s-text); opacity: 1; }
  .bringer-search-form svg { position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); color: var(--blog-accent); pointer-events: none; }
  .blog-archive-link { margin-top: 1rem; font-size: .9rem; }
  .blog-archive-link a { color: var(--bringer-s-text); text-decoration: underline; text-underline-offset: .25em; }
  .blog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--stg-gap); }
  .blog-filters { display: flex; flex-wrap: wrap; gap: .75rem; justify-content: center; margin-bottom: 1.5rem; }
  .blog-filters button { font: inherit; font-size: .9375rem; color: var(--bringer-s-text); background: var(--bringer-s-container-bg); border: 1px solid var(--bringer-s-border); border-radius: var(--bringer-small-br); padding: .625rem 1.25rem; cursor: pointer; }
  .blog-filters button:is(:hover,[aria-pressed="true"]) { color: #fff; background: #b80046; border-color: #b80046; }
  #archivo-blog { scroll-margin-top: 100px; }
  #blog-results { font-size: .85rem; color: var(--bringer-s-text); margin-bottom: 2rem; }
  .blog-rss-card .bringer-button { margin-top: 1rem; }
  .blog-index :is(button,input,a):focus-visible { outline: 3px solid var(--blog-accent); outline-offset: 4px; }
  @media(max-width: 1000px) { .blog-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(max-width: 650px) { .blog-grid { grid-template-columns: minmax(0,1fr); } }
</style>
