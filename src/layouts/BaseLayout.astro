---
import ThemeToggle from '../components/ThemeToggle.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Analytics from '../components/Analytics.astro';
import JsonLd from '../components/geo/JsonLd.astro';
import { organization, webSite } from '../lib/schema';
import { assetUrl } from '../lib/assets';

const { 
    title = 'Edición Aular | Diseño web y soluciones de IA en Medellín',
    description = 'Somos una agencia de diseño web, publicidad digital y soluciones de Inteligencia Artificial en Medellín. Desarrollamos páginas web, automatizaciones y agentes de WhatsApp con resultados medibles.',
    image = '/img/social-edicion.webp',
    type = 'website'
} = Astro.props;

const socialImage = new URL(image, Astro.site).href;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const secondaryScripts = ['/js/lib/libs.js', '/js/st-core.js', '/js/classes.js', '/js/main.js'].map(assetUrl);
const isPreview = ['deploy-preview', 'branch-deploy'].includes(process.env.CONTEXT || '');
---

<!DOCTYPE html>
<html lang="es-CO">
<head>
    <meta charset="UTF-8">
    <script is:inline>
      try { document.documentElement.classList.toggle('light-mode', localStorage.getItem('theme') === 'light'); } catch (_) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Page Title -->
    <title>{title}</title>
    
    <!-- Meta Description -->
    <meta name="description" content={description}>
    <link rel="alternate" type="application/rss+xml" title="Blog de Edición Aular" href="/rss.xml" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    <meta name="google-site-verification" content="1CWG9HSA1bg0q-_Qq2kOPN1rDgFWFYdh0BQ8I5fnklc" />
    
    <!-- DNS Prefetch y Preconnect optimizados -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="dns-prefetch" href="https://tresmarketing.s3.us-east-1.amazonaws.com">
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://tresmarketing.s3.us-east-1.amazonaws.com">
    
    <!-- Preload crítico para HOME hero poster y CSS -->
    {Astro.url.pathname === '/' && (
        <>
            <link rel="preload" as="image" href="/img/home/home03-hero2.jpg" fetchpriority="high">
            <link rel="preload" as="style" href={assetUrl('/css/config.css')}>
            <link rel="preload" as="style" href={assetUrl('/css/style.css')}>
        </>
    )}
    <!-- Google Fonts (optimizado con preload + font-display swap) -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    </noscript>
    
    <!-- CSS crítico inline en HEAD, resto async -->
    <link rel="stylesheet" href={assetUrl('/css/config.css')}>
    <link rel="stylesheet" href={assetUrl('/css/libs.css')}>
    <link rel="stylesheet" href={assetUrl('/css/style.css')}>
    <link rel="stylesheet" href={assetUrl('/css/responsive.css')} media="all">
    <link rel="stylesheet" href={assetUrl('/css/geo-theme.css')}>
    <!-- Light Mode Theme (async load) -->
    <link rel="stylesheet" href={assetUrl('/css/theme-light.css')}>
    <!-- Fullwidth Fix (async load) -->
    <link rel="stylesheet" href={assetUrl('/css/fullwidth-fix.css')} media="print" onload="this.media='all'">
    <!-- CTA Gradient (async load) -->
    <link rel="stylesheet" href={assetUrl('/css/cta-gradient.css')} media="print" onload="this.media='all'">
    <noscript>
        <link rel="stylesheet" href={assetUrl('/css/theme-light.css')}>
        <link rel="stylesheet" href={assetUrl('/css/fullwidth-fix.css')}>
        <link rel="stylesheet" href={assetUrl('/css/cta-gradient.css')}>
    </noscript>
    
    <!-- Favicon y PWA -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml">
    <link rel="icon" href="/favicon.png" sizes="96x96" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#ff0080">
    
    <!-- Metadatos Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Edición Aular" />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <!-- Metadatos Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@edaborofficial" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    
    <!-- Meta tags adicionales SEO -->
    <meta property="og:locale" content="es_CO" />
    <meta name="author" content="Edición Aular" />
    <meta name="robots" content={isPreview ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    
    <!-- Meta tags de Geolocalización - Medellín, Colombia -->
    <meta name="geo.region" content="CO-ANT" />
    <meta name="geo.placename" content="Medellín, Antioquia, Colombia" />

    
    <JsonLd data={[organization(), webSite()]} />
    
    
    <!-- Critical CSS para prevenir CLS y optimización mobile -->
    <style is:global>
        .bringer-large-text {
            font-size: var(--bringer-t-large-fs);
            line-height: var(--bringer-t-content-lh);
            color: var(--bringer-s-heading);
        }
        
        /* Logo en light mode - NEGRO COMPLETO */
        html.light-mode .bringer-logo img {
            filter: brightness(0) saturate(100%) !important;
        }
        
        /* Hamburguesa BLANCA en light mode */
        html.light-mode .bringer-menu-toggler-icon span {
            background-color: #ffffff !important;
        }
        html.light-mode body.show-menu .bringer-menu-toggler-icon span {
            background-color: var(--bringer-s-heading) !important;
        }
        
        /* Prevenir Layout Shift en imágenes */
        img[width][height] {
            height: auto;
            aspect-ratio: attr(width) / attr(height);
        }
        
        /* Hero video container */
        .bringer-hero-media video {
            width: 100%;
            height: auto;
            aspect-ratio: 16/9;
        }
        
        /* Portfolio cards */
        .bringer-portfolio-card-image {
            position: relative;
            aspect-ratio: 1/1;
            overflow: hidden;
        }
        
        .bringer-portfolio-card-image img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* Skeleton loading para mejor UX */
        .bringer-lazy[data-src]:not([src]) {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
        }
        
        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        
        /* Optimización de fuentes para mejor render */
        body {
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
        }
        
        /* GPU acceleration para elementos animados */
        [data-appear], 
        .swiper-slide,
        .bringer-carousel {
            will-change: transform, opacity;
        }
        
        /* Contenido above-the-fold visible inmediatamente */
        .bringer-page-title {
            font-size: clamp(2rem, 5vw, 4rem);
            line-height: 1.2;
        }
        
        /* OPTIMIZACIONES MOBILE-FIRST */
        
        /* Touch targets mínimos 44x44px (WCAG) */
        a, button, input, select, textarea {
            min-height: 44px;
            min-width: 44px;
        }
        
        /* Mejorar tap highlights */
        * {
            -webkit-tap-highlight-color: rgba(255, 0, 128, 0.2);
            tap-highlight-color: rgba(255, 0, 128, 0.2);
        }
        
        /* Prevenir zoom en inputs (mobile) */
        @media screen and (max-width: 768px) {
            input, select, textarea {
                font-size: 16px !important;
            }
        }
        
        /* Optimizar scroll en mobile */
        html {
            -webkit-overflow-scrolling: touch;
            scroll-behavior: smooth;
        }
        
        /* Reducir motion para usuarios sensibles */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
        
        /* Container queries para componentes responsive */
        @supports (container-type: inline-size) {
            .bringer-portfolio-card {
                container-type: inline-size;
            }
        }
        
        /* ========================================
           LIGHT MODE - Tarjetas con fondo accent/rosa
           ======================================== */
        html.light-mode .bringer-block.is-accented,
        html.light-mode .bringer-masked-media.is-accented,
        html.light-mode .bringer-masked-block .bringer-block.is-accented {
            background-color: #ff005f !important;
            background: #ff005f !important;
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
        }
        
        html.light-mode .bringer-block.is-accented h5,
        html.light-mode .bringer-block.is-accented p,
        html.light-mode .bringer-block.is-accented .bringer-large-text,
        html.light-mode .bringer-masked-media.is-accented h5,
        html.light-mode .bringer-masked-media.is-accented p,
        html.light-mode .bringer-masked-media.is-accented .bringer-large-text {
            color: #FFFFFF !important;
        }
        
        /* Quitar borde y sombra de todas las tarjetas en light mode */
        html.light-mode .bringer-block {
            border-color: rgba(0, 0, 0, 0.08) !important;
            box-shadow: none !important;
        }
        
        html.light-mode .bringer-masked-block .bringer-block.is-accented {
            border-color: transparent !important;
        }
        
        /* Barra de búsqueda en light mode */
        html.light-mode input[type="text"],
        html.light-mode input[type="search"],
        html.light-mode .blog-search-input,
        html.light-mode input[placeholder*="Buscar"] {
            background-color: #FFFFFF !important;
            border: 1px solid rgba(0, 0, 0, 0.15) !important;
            color: #1a1a1a !important;
        }
        
        html.light-mode input[type="text"]::placeholder,
        html.light-mode input[type="search"]::placeholder,
        html.light-mode .blog-search-input::placeholder {
            color: #666666 !important;
        }
        
        /* Barra de progreso de lectura - siempre visible */
        #reading-progress-bar {
            position: fixed !important;
            bottom: 0 !important;
            left: 0 !important;
            z-index: 2147483647 !important; /* Máximo z-index posible */
            isolation: isolate !important;
        }
        
        /* Asegurar que el footer no cubra la barra */
        #bringer-footer {
            z-index: 20 !important;
        }
    </style>
    
    <!-- Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(() => {});
            });
        }
    </script>
    
    <!-- Prefetch páginas comunes para navegación instantánea -->
    {Astro.url.pathname === '/' && (
        <>
            <link rel="prefetch" href="/nosotros" as="document">
            <link rel="prefetch" href="/portfolio" as="document">
        </>
    )}
    <!-- Slot para JSON-LD y metadatos específicos de cada página (SEO/GEO) -->
    <slot name="head" />
</head>

