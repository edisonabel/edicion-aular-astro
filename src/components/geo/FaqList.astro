---
import type { FAQ } from '../../data/ia/soluciones';
interface Props { faqs: FAQ[]; titulo?: string; categoria?: string; id?: string }
const { faqs, titulo = 'Preguntas frecuentes', categoria = 'Preguntas frecuentes', id = 'preguntas-frecuentes' } = Astro.props;
---
<section class="geo-faq stg-bottom-gap-l" id={id} data-template="pricing.html#faq">
  <div class="stg-row stg-bottom-gap-l">
    <div class="stg-col-8 stg-offset-2 align-center"><h2>{titulo}</h2></div>
  </div>
  <div class="bringer-faq-list">
    {faqs.map((faq, index) => (
      <details class="geo-faq-item bringer-block">
        <summary class="geo-faq-title">
          <span class="bringer-label">{categoria}</span>
          <h3><span class="geo-faq-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}.</span> {faq.q}</h3>
        </summary>
        <div class="geo-faq-content"><p>{faq.a}</p></div>
      </details>
    ))}
  </div>
</section>
